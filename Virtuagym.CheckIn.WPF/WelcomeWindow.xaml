<Window x:Class="Virtuagym.CheckIn.WPF.WelcomeWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Title="Virtuagym Check-in" 
		WindowStyle="None" WindowState="Normal" 
		Topmost="True" Background="White"
		AllowsTransparency="False"
		ResizeMode="NoResize"
		Loaded="Window_Loaded">

	<Grid x:Name="gridMain">
		<Border x:Name="borderBackground" Visibility="Collapsed">
			<Border.Background>
				<ImageBrush x:Name="imgBackgroundBrush" Stretch="Uniform" AlignmentX="Center" AlignmentY="Center"/>
			</Border.Background>
		</Border>

		<Image x:Name="imgClubLogo" Width="200" Height="80"
			   HorizontalAlignment="Left" VerticalAlignment="Top" 
			   Margin="30,30,0,0" Stretch="Uniform"/>

		<!-- Loading Indicator (zentriert, während Check-in läuft) -->
		<Border x:Name="panelLoader" HorizontalAlignment="Center" VerticalAlignment="Center" 
				Visibility="Collapsed" Background="#CC000000" CornerRadius="16" Padding="40,30">
			<StackPanel>
				<TextBlock x:Name="txtPleaseWait" Text="Bitte warten..." FontSize="28" Foreground="White" 
						   HorizontalAlignment="Center" FontWeight="SemiBold"/>
				<ProgressBar IsIndeterminate="True" Width="220" Height="6" Margin="0,16,0,0"
							 Foreground="White" Background="#33FFFFFF" BorderThickness="0"/>
			</StackPanel>
		</Border>

		<!-- Check-in Info-Panel (rechts, nach Check-in sichtbar) -->
		<Border x:Name="borderCheckinInfo" 
				HorizontalAlignment="Right" VerticalAlignment="Center"
				Margin="0,0,50,0" Visibility="Collapsed"
				Background="#CC000000" CornerRadius="20" Padding="30,28"
				MinWidth="340" MaxWidth="520">
			<StackPanel>
				<!-- Avatar Container mit Overlay-Icons -->
				<Grid HorizontalAlignment="Center" Margin="0,0,0,16">
					<Border x:Name="borderCheckinAvatar" Width="180" Height="180" CornerRadius="90"
							BorderBrush="White" BorderThickness="3" Background="#33FFFFFF"
							Visibility="Collapsed">
						<Border.Clip>
							<EllipseGeometry Center="90,90" RadiusX="90" RadiusY="90"/>
						</Border.Clip>
						<Grid>
							<!-- Fallback User-Icon (sichtbar wenn kein Avatar und Check-in erfolgreich) -->
							<Viewbox x:Name="iconUserFallback" Margin="35" Visibility="Visible">
								<Canvas Width="24" Height="24">
									<!-- Kopf (Kreis) -->
									<Ellipse Canvas.Left="6" Canvas.Top="3" Width="12" Height="12"
											 Fill="White" Opacity="0.7"/>
									<!-- Oberkörper (abgerundeter Pfad) -->
									<Path Data="M12,15 C7,15 3,17.5 3,20.5 L3,23 L21,23 L21,20.5 C21,17.5 17,15 12,15 Z"
										  Fill="White" Opacity="0.7"/>
								</Canvas>
							</Viewbox>
							<!-- Fehler-Icon (X-Kreis, sichtbar bei gescheitertem Check-in / unbekannte Karte / zu wenig Credits) -->
							<Viewbox x:Name="iconErrorFallback" Margin="30" Visibility="Collapsed">
								<Canvas Width="24" Height="24">
									<Ellipse Canvas.Left="1" Canvas.Top="1" Width="22" Height="22" Fill="#CCFF4444"/>
									<Path Data="M7,7 L17,17 M17,7 L7,17" Stroke="White" StrokeThickness="2.5"
										  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
								</Canvas>
							</Viewbox>
							<!-- Warn-Icon (Dreieck, sichtbar bei Warnung oder Doppelscan-Schutz) -->
							<Viewbox x:Name="iconWarnFallback" Margin="30" Visibility="Collapsed">
								<Canvas Width="24" Height="24">
									<Path Data="M12,3 L22,21 L2,21 Z" Fill="#CCFF9900"/>
									<Path Data="M12,9 L12,15" Stroke="White" StrokeThickness="2.5"
										  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
									<Ellipse Canvas.Left="10.5" Canvas.Top="17" Width="3" Height="3" Fill="White"/>
								</Canvas>
							</Viewbox>
							<Image x:Name="imgCheckinAvatar" Stretch="UniformToFill"/>
						</Grid>
					</Border>

					<!-- Overlay Status-Icons (unten rechts am Avatar) -->
					<!-- Success Checkmark Overlay -->
					<Border x:Name="overlaySuccess" Width="56" Height="56" CornerRadius="28"
							Background="#4CAF50" BorderBrush="White" BorderThickness="3"
							HorizontalAlignment="Right" VerticalAlignment="Bottom"
							Margin="0,0,8,8" Visibility="Collapsed">
						<Viewbox Margin="12">
							<Canvas Width="24" Height="24">
								<!-- Checkmark -->
								<Path Data="M9,16.2 L4.8,12 L3.4,13.4 L9,19 L21,7 L19.6,5.6 Z" Fill="White"/>
							</Canvas>
						</Viewbox>
					</Border>

					<!-- Error X Overlay -->
					<Border x:Name="overlayError" Width="56" Height="56" CornerRadius="28"
							Background="#F44336" BorderBrush="White" BorderThickness="3"
							HorizontalAlignment="Right" VerticalAlignment="Bottom"
							Margin="0,0,8,8" Visibility="Collapsed">
						<Viewbox Margin="12">
							<Canvas Width="24" Height="24">
								<!-- X Mark -->
								<Path Data="M19,6.4 L17.6,5 L12,10.6 L6.4,5 L5,6.4 L10.6,12 L5,17.6 L6.4,19 L12,13.4 L17.6,19 L19,17.6 L13.4,12 Z" Fill="White"/>
							</Canvas>
						</Viewbox>
					</Border>

					<!-- Warning Triangle Overlay -->
					<Border x:Name="overlayWarning" Width="56" Height="56" CornerRadius="28"
							Background="#FF9800" BorderBrush="White" BorderThickness="3"
							HorizontalAlignment="Right" VerticalAlignment="Bottom"
							Margin="0,0,8,8" Visibility="Collapsed">
						<Viewbox Margin="12">
							<Canvas Width="24" Height="24">
								<!-- Warning Triangle -->
								<Path Data="M1,21 L12,2 L23,21 Z" Fill="White" Opacity="0.9"/>
								<Path Data="M12,10 L12,14" Stroke="#FF9800" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
								<Ellipse Canvas.Left="11" Canvas.Top="16" Width="2" Height="2" Fill="#FF9800"/>
							</Canvas>
						</Viewbox>
					</Border>

					<!-- DoubleScan Info Overlay -->
					<Border x:Name="overlayDoubleScan" Width="56" Height="56" CornerRadius="28"
							Background="#2196F3" BorderBrush="White" BorderThickness="3"
							HorizontalAlignment="Right" VerticalAlignment="Bottom"
							Margin="0,0,8,8" Visibility="Collapsed">
						<Viewbox Margin="12">
							<Canvas Width="24" Height="24">
								<!-- Info Icon (i) -->
								<Ellipse Canvas.Left="10.5" Canvas.Top="6" Width="3" Height="3" Fill="White"/>
								<Path Data="M12,10 L12,18" Stroke="White" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
							</Canvas>
						</Viewbox>
					</Border>
				</Grid>
				<TextBlock x:Name="txtCheckinName"
						   FontSize="28" FontWeight="Bold" Foreground="White"
						   HorizontalAlignment="Center" TextAlignment="Center"
						   TextWrapping="Wrap" MaxWidth="460"/>
				<TextBlock x:Name="txtCheckinStatus"
						   FontSize="18" Foreground="#CCCCCC" Margin="0,8,0,0"
						   HorizontalAlignment="Center" TextAlignment="Center"
						   TextWrapping="Wrap" MaxWidth="460"/>
				<TextBlock x:Name="txtCheckinReaderName"
						   FontSize="13" Foreground="#88FFFFFF" Margin="0,12,0,0"
						   HorizontalAlignment="Center" TextAlignment="Center"
						   TextWrapping="Wrap" MaxWidth="460"/>
			</StackPanel>
		</Border>

		<TextBlock x:Name="txtIdleHint"
				   Text="Bitte halten Sie Ihre RFID-Karte an den Leser"
				   FontSize="20" Foreground="#88000000"
				   HorizontalAlignment="Center" VerticalAlignment="Bottom"
				   Margin="0,0,0,50"/>

		<!-- QR-Code Kamera-Vorschau (unten links) -->
		<Border x:Name="borderQrCameraPreview" 
				HorizontalAlignment="Left" VerticalAlignment="Bottom"
				Margin="30,0,0,30" Visibility="Collapsed"
				Background="#DD000000" CornerRadius="12" Padding="8">
			<StackPanel>
				<!-- Header -->
				<Grid Margin="0,5,0,8">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>
					<Border Grid.Column="0" Width="24" Height="24" Margin="0,0,8,0"
							Background="#4CAF50" CornerRadius="4" VerticalAlignment="Center">
						<Viewbox Margin="4">
							<Canvas Width="24" Height="24">
								<Rectangle Canvas.Left="2" Canvas.Top="2" Width="8" Height="8" Fill="White"/>
								<Rectangle Canvas.Left="14" Canvas.Top="2" Width="8" Height="8" Fill="White"/>
								<Rectangle Canvas.Left="2" Canvas.Top="14" Width="8" Height="8" Fill="White"/>
								<Rectangle Canvas.Left="16" Canvas.Top="16" Width="4" Height="4" Fill="White"/>
							</Canvas>
						</Viewbox>
					</Border>
					<StackPanel Grid.Column="1" VerticalAlignment="Center">
						<TextBlock Text="QR-Code Scanner" FontSize="12" FontWeight="SemiBold" 
								   Foreground="White" Margin="0,0,0,2"/>
						<TextBlock Text="Vorschau aller Kameras" FontSize="10" Foreground="#AAFFFFFF"/>
					</StackPanel>
				</Grid>

				<!-- Kamera-Kacheln -->
				<ItemsControl x:Name="icQrCameraPreviews">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<WrapPanel Orientation="Horizontal"/>
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Border Background="#00000000" Margin="0,0,10,0">
								<StackPanel>
									<TextBlock Text="{Binding Label}" FontSize="10" Foreground="#AAFFFFFF" Margin="4,0,0,4"/>
									<Grid>
										<Border Background="#222222" CornerRadius="6" BorderBrush="#555555" BorderThickness="1">
											<Image Width="210" Height="150" Stretch="UniformToFill" Source="{Binding PreviewImage}"/>
										</Border>
										<Viewbox Width="100" Height="100" Stretch="Uniform">
											<Canvas Width="100" Height="100">
												<Path Data="M10,10 L10,25 M10,10 L25,10" Stroke="#4CAF50" StrokeThickness="3" 
													  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.8"/>
												<Path Data="M90,10 L90,25 M90,10 L75,10" Stroke="#4CAF50" StrokeThickness="3" 
													  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.8"/>
												<Path Data="M10,90 L10,75 M10,90 L25,90" Stroke="#4CAF50" StrokeThickness="3" 
													  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.8"/>
												<Path Data="M90,90 L90,75 M90,90 L75,90" Stroke="#4CAF50" StrokeThickness="3" 
													  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.8"/>
											</Canvas>
										</Viewbox>
									</Grid>
									<TextBlock Text="{Binding Status}" FontSize="11" Foreground="#4CAF50" 
											   HorizontalAlignment="Center" Margin="0,8,0,4" FontWeight="Medium"/>
								</StackPanel>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</StackPanel>
		</Border>

		<!-- Hardware Error Box (erscheint bei Relay/PG-Fehler, unten rechts) -->
		<Border x:Name="borderHardwareError" HorizontalAlignment="Right" VerticalAlignment="Center"
				Margin="0,0,50,40" Visibility="Collapsed"
				Background="#CC7B1A1A" CornerRadius="14" Padding="18,14"
				MinWidth="280" MaxWidth="480" BorderBrush="#FFAA2222" BorderThickness="1.5">
			<StackPanel Orientation="Horizontal">
				<Viewbox Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center">
					<Canvas Width="24" Height="24">
						<Path Data="M1,21 L12,2 L23,21 Z" Fill="#FFEE4444" Opacity="0.9"/>
						<Path Data="M12,9 L12,15" Stroke="White" StrokeThickness="2.5"
							  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
						<Ellipse Canvas.Left="10.5" Canvas.Top="17" Width="3" Height="3" Fill="White"/>
					</Canvas>
				</Viewbox>
				<TextBlock x:Name="txtHardwareError" FontSize="15" Foreground="#FFFF8888"
						   VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="400" Text="Türöffnung fehlgeschlagen: Relay antwortet nicht."/>
			</StackPanel>
		</Border>

		<!-- Device unavailable warning (top-right, like Web) -->
		<Border x:Name="borderDeviceWarning"
				HorizontalAlignment="Right" VerticalAlignment="Top"
				Margin="0,20,20,0" Visibility="Collapsed"
				Background="#CC000000" BorderBrush="#F44336" BorderThickness="2"
				CornerRadius="12" Padding="12,8">
			<StackPanel x:Name="panelDeviceWarnings" />
		</Border>
	</Grid>
</Window>
