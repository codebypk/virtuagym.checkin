<Window x:Class="Virtuagym.CheckIn.WPF.EditAccessPassWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Access Pass bearbeiten" Height="480" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Name -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Name:" Margin="0,0,0,4"/>
            <TextBox x:Name="txtName" Height="24"/>
        </StackPanel>

        <!-- Card-ID -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="Card-ID:" Margin="0,0,0,4"/>
            <TextBox x:Name="txtCardId" Height="24"/>
            <TextBlock Text="Karten-ID oder Kennung für die Zuordnung beim Scannen"
                       FontSize="10" Foreground="Gray" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Total Uses -->
        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Text="Gesamtanzahl Nutzungen:" Margin="0,0,0,4"/>
            <TextBox x:Name="txtTotalUses" Height="24"/>
        </StackPanel>

        <!-- Remaining Uses -->
        <StackPanel Grid.Row="3" Margin="0,0,0,12">
            <TextBlock Text="Verbleibende Nutzungen:" Margin="0,0,0,4"/>
            <TextBox x:Name="txtRemainingUses" Height="24"/>
        </StackPanel>

        <!-- Valid From / Until -->
        <Grid Grid.Row="4" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Gültig ab:" Margin="0,0,0,4"/>
                <DatePicker x:Name="dpValidFrom"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Gültig bis:" Margin="0,0,0,4"/>
                <DatePicker x:Name="dpValidUntil"/>
            </StackPanel>
        </Grid>

        <!-- IsActive -->
        <StackPanel Grid.Row="5" Margin="0,0,0,12">
            <CheckBox x:Name="chkIsActive" Content="Pass ist aktiv" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Validation Message -->
        <TextBlock x:Name="txtValidationMessage" Grid.Row="7" 
                   Foreground="Red" TextWrapping="Wrap" 
                   Visibility="Collapsed" Margin="0,0,0,10"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnSave" Content="Speichern" Width="100" Height="30" 
                    Margin="0,0,10,0" Click="btnSave_Click" IsDefault="True"/>
            <Button x:Name="btnCancel" Content="Abbrechen" Width="100" Height="30" 
                    Click="btnCancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
