<UserControl x:Class="Virtuagym.CheckIn.WPF.Controls.JablotronClientControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Virtuagym.CheckIn.WPF.Controls"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="800">
    <TabControl Margin="5">

        <!-- Sub-Tab 1: API-Verbindung -->
        <TabItem x:Name="tabJablotronApiConnection" Header="API-Verbindung">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Background="White">
                <StackPanel Margin="10">
                    <GroupBox x:Name="grpJablotronApi" Header="Jablotron Cloud API" Margin="0,0,0,10">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="lblJablotronApiUrl" Grid.Row="0" Grid.Column="0" Text="API-URL:" VerticalAlignment="Center" Margin="0,5"/>
                            <TextBox x:Name="txtJablotronApiUrl" Grid.Row="0" Grid.Column="1" Margin="0,5"
                                     ToolTip="Basis-URL der Jablotron Cloud API (z.B. https://api.jablonet.net/api/2.4)."/>

                            <TextBlock x:Name="lblJablotronApiUsername" Grid.Row="1" Grid.Column="0" Text="Benutzername:" VerticalAlignment="Center" Margin="0,5"/>
                            <TextBox x:Name="txtJablotronApiUsername" Grid.Row="1" Grid.Column="1" Margin="0,5"
                                     ToolTip="Benutzername f&#252;r die Jablotron Cloud API."/>

                            <TextBlock x:Name="lblJablotronApiPassword" Grid.Row="2" Grid.Column="0" Text="Passwort:" VerticalAlignment="Center" Margin="0,5"/>
                            <PasswordBox x:Name="txtJablotronApiPassword" Grid.Row="2" Grid.Column="1" Margin="0,5"
                                         ToolTip="Passwort f&#252;r die Jablotron Cloud API."/>

                            <TextBlock x:Name="lblJablotronApiPinCode" Grid.Row="3" Grid.Column="0" Text="PIN-Code:" VerticalAlignment="Center" Margin="0,5"/>
                            <PasswordBox x:Name="txtJablotronApiPinCode" Grid.Row="3" Grid.Column="1" Margin="0,5" ToolTip="PIN-Code für die Jablotron Cloud API."/>
                        </Grid>
                    </GroupBox>

                    <GroupBox x:Name="grpJablotronConnectionTest" Header="Verbindungstest" Margin="0,0,0,10">
                        <StackPanel Margin="10">
                            <Button x:Name="btnTestJablotronConnection"
                                    Content="Verbindung testen" Width="150" Height="28" HorizontalAlignment="Left"
                                    Click="btnTestJablotronConnection_Click"/>
                            <TextBlock x:Name="txtJablotronTestResult"
                                       TextWrapping="Wrap" Foreground="Gray" FontSize="12" Margin="0,5,0,0"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <!-- Sub-Tab 2: Service & Gates -->
        <TabItem x:Name="tabJablotronServiceAndGates" Header="Service &amp; Gates">
            <TabControl Margin="5">
                <TabItem x:Name="tabJablotronServices" Header="Service">
                    <Grid Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,5,0,5">
                            <Button x:Name="btnLoadServices"
                                    Content="Services laden" Width="120" Height="28" Margin="0,0,10,0"
                                    Click="btnLoadServices_Click"
                                    ToolTip="L&#228;dt alle Services von der Jablotron Cloud API."/>
                            <TextBlock x:Name="txtServicesStatus" VerticalAlignment="Center" Foreground="Gray" FontSize="12"/>
                        </StackPanel>

                        <DataGrid x:Name="dataGridServices" Grid.Row="1"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Single" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Service ID" Binding="{Binding ServiceId}" Width="90"/>
                                <DataGridTextColumn Header="Cloud Entity ID" Binding="{Binding CloudEntityId}" Width="160"/>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Service Type" Binding="{Binding ServiceType}" Width="140"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="220"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem x:Name="tabJablotronProgrammableGates" Header="Programmable Gates">
                    <Grid Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,5,0,5">
                            <Button x:Name="btnLoadProgrammableGates"
                                    Content="Gates laden" Width="120" Height="28" Margin="0,0,10,0"
                                    Click="btnLoadProgrammableGates_Click"
                                    ToolTip="L&#228;dt die Programmable Gates von der Jablotron Cloud API."/>
                            <TextBlock x:Name="txtProgrammableGatesStatus" VerticalAlignment="Center" Foreground="Gray" FontSize="12"/>
                        </StackPanel>

                        <DataGrid x:Name="dataGridProgrammableGates" Grid.Row="1"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Single" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Cloud Component ID" Binding="{Binding CloudComponentId}" Width="200"/>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="80"/>
                                <DataGridCheckBoxColumn Header="Can Control" Binding="{Binding CanControl}" Width="90"/>
                                <DataGridCheckBoxColumn Header="Need Auth" Binding="{Binding NeedAuthorization}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>
        </TabItem>

        <TabItem x:Name="tabJablotronFLink" Header="F-Link / RFID">
            <controls:DeveloperJablotronControl x:Name="developerJablotronControl"/>
        </TabItem>

        <!-- Sub-Tab: SIA DC-09 -->
        <TabItem x:Name="tabSiaDc09" Header="SIA DC-09">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,5,0,10">
                    <TextBlock x:Name="lblSiaPort" Text="Port:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="txtSiaPort" Width="80" VerticalAlignment="Center" Text="33300"
                             ToolTip="UDP-Port für den SIA DC-09 Server."/>
                    <Button x:Name="btnSiaStartStop" Content="Server starten" Width="120" Height="28" Margin="15,0,0,0"
                            Click="btnSiaStartStop_Click"/>
                    <TextBlock x:Name="txtSiaStatus" VerticalAlignment="Center" Foreground="Gray" FontSize="12" Margin="15,0,0,0"/>
                    <Button x:Name="btnSiaClear" Content="Log leeren" Width="100" Height="28" Margin="15,0,0,0"
                            Click="btnSiaClear_Click"/>
                </StackPanel>

                <DataGrid x:Name="dataGridSiaMessages" Grid.Row="1"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Zeit" Binding="{Binding ReceivedAt}" Width="160"/>
                        <DataGridTextColumn Header="Remote EP" Binding="{Binding RemoteEndPoint}" Width="160"/>
                        <DataGridTextColumn Header="Account" Binding="{Binding AccountNumber}" Width="100"/>
                        <DataGridTextColumn Header="Event Code" Binding="{Binding EventCode}" Width="90"/>
                        <DataGridTextColumn Header="Beschreibung" Binding="{Binding EventDescription}" Width="200"/>
                        <DataGridTextColumn Header="Zone" Binding="{Binding Zone}" Width="60"/>
                        <DataGridTextColumn Header="User" Binding="{Binding User}" Width="60"/>
                        <DataGridTextColumn Header="Raw" Binding="{Binding RawText}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>

    </TabControl>
</UserControl>





