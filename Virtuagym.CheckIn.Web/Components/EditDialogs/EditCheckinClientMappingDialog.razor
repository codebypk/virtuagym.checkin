    private async Task SendDeviceTestCommand(byte[] command, string commandName)
    {
        string selectedDeviceId = !string.IsNullOrWhiteSpace(_selectedDeviceId) ? _selectedDeviceId : Mapping.DeviceID;
        if (string.IsNullOrWhiteSpace(selectedDeviceId))
        {
            _testResult = L.T("Web_EditMapping_NoDevice");
            _testResultColor = "orange";
            return;
        }

        _testRunning = true;
        _testResult = string.Format(L.T("Web_EditMapping_SendingCommand"), commandName, selectedDeviceId);
        _testResultColor = "gray";
        StateHasChanged();

        try
        {
            var result = await Task.Run(() =>
            {
                var hidDevices = HidDevices.Enumerate();
                HidDevice targetDevice = null;

                foreach (var device in hidDevices)
                {
                    string escapedPattern = Regex.Escape(selectedDeviceId).Replace(Regex.Escape("&8"), "[#&]8");
                    if (Regex.IsMatch(device.DevicePath, escapedPattern, RegexOptions.IgnoreCase))
                    {
                        targetDevice = device;
                        break;
                    }
                }

                if (targetDevice == null)
                    return ("red", L.T("Web_EditMapping_DeviceNotFound"));

                targetDevice.OpenDevice();
                if (!targetDevice.IsConnected)
                {
                    targetDevice.CloseDevice();
                    return ("red", L.T("Web_EditMapping_DeviceOpenFailed"));
                }

                bool writeSuccess = targetDevice.Write(command);

                if (commandName == "Read")
                {
                    var report = targetDevice.Read(3000);
                    targetDevice.CloseDevice();

                    if (report.Status == HidDeviceData.ReadStatus.Success)
                    {
                        var card = new Card(report.Data);
                        if (card.IsValidTag)
                        {
#pragma warning disable CS0618
                            string info = L.T("Web_EditMapping_CardDetected") + "\n"
                                + "  " + L.T("Web_EditMapping_UidHex") + "              " + card.UidHex + "\n"
                                + "  " + L.T("Web_EditMapping_Standard10Digit") + "  " + card.GetCardId(CardIdMode.Lower3Bytes) + "\n"
                                + "  " + L.T("Web_EditMapping_MifareClassic") + "       " + card.GetCardId(CardIdMode.Lower4Bytes) + "\n"
                                + "  " + L.T("Web_EditMapping_FullUidDecimal") + "    " + card.GetCardId(CardIdMode.FullDecimal) + "\n"
                                + "  " + L.T("Web_EditMapping_FullUidHex") + "        " + card.GetCardId(CardIdMode.FullHex) + "\n"
                                + "  " + L.T("Web_EditMapping_UidLegacy") + "           " + card.UidLegacy;
#pragma warning restore CS0618
                            return ("green", info);
                        }
                        string hexData = BitConverter.ToString(report.Data);
                        return ("green", string.Format(L.T("Web_EditMapping_Response"), hexData));
                    }
                    return ("orange", L.T("Web_EditMapping_NoCardDetected"));
                }
                else
                {
                    targetDevice.CloseDevice();
                    return writeSuccess
                        ? ("green", L.T("Web_EditMapping_BeepSuccess"))
                        : ("red", L.T("Web_EditMapping_BeepFailed"));
                }
            });

            _testResult = result.Item2;
            _testResultColor = result.Item1;
        }
        catch (Exception ex)
        {
            _testResult = string.Format(L.T("Web_EditMember_Error"), ex.Message);
            _testResultColor = "red";
        }
        finally
        {
            _testRunning = false;
        }
    }

