            {
                VideoCaptureAPIs.ANY          => L.T("Web_EditMapping_BackendAutomatic"),
                VideoCaptureAPIs.V4L          => "V4L/V4L2 [Linux]",
                VideoCaptureAPIs.FIREWIRE     => "IEEE 1394 / FireWire",
                VideoCaptureAPIs.DSHOW        => "DirectShow (DSHOW) [Windows]",
                VideoCaptureAPIs.PVAPI        => "PvAPI / Prosilica GigE",
                VideoCaptureAPIs.OPENNI       => "OpenNI",
                VideoCaptureAPIs.OPENNI_ASUS  => "OpenNI ASUS Xtion",
                VideoCaptureAPIs.ANDROID      => "Android MediaNDK",
                VideoCaptureAPIs.XIAPI        => "XIMEA Camera API",
                VideoCaptureAPIs.AVFOUNDATION => "AVFoundation [macOS/iOS]",
                VideoCaptureAPIs.GIGANETIX    => "Smartek Giganetix GigE",
                VideoCaptureAPIs.MSMF         => "Media Foundation (MSMF) [Windows]",
                VideoCaptureAPIs.WINRT        => "Windows Runtime (WINRT) [Windows]",
                VideoCaptureAPIs.INTELPERC    => "Intel RealSense (PerC)",
                VideoCaptureAPIs.OPENNI2      => "OpenNI2",
                VideoCaptureAPIs.OPENNI2_ASUS => "OpenNI2 ASUS",
                VideoCaptureAPIs.GPHOTO2      => "gPhoto2 [Linux/macOS]",
                VideoCaptureAPIs.GSTREAMER    => "GStreamer",
                VideoCaptureAPIs.FFMPEG       => "FFmpeg",
                VideoCaptureAPIs.IMAGES       => L.T("Web_EditMapping_BackendImageSequence"),
                VideoCaptureAPIs.ARAVIS       => "Aravis GigE [Linux]",
                VideoCaptureAPIs.INTEL_MFX    => "Intel Media SDK",
                VideoCaptureAPIs.XINE         => "Xine [Linux]",
                _                             => api.ToString()
            }))
            .ToList();

        // Load HID profiles
        try { _hidProfiles = HidProfileLoader.Load(); } catch { }

        // Load serial ports
        try { _serialPorts = SerialPort.GetPortNames().OrderBy(p => p).ToArray(); } catch { }

        // Load credit services
        try { _creditServices = ClubServiceLoader.Load().Where(s => s.isActive).ToList(); } catch { }

        // Load PG gates
        ReloadPgGates();

        // Set state from mapping
        _selectedDeviceId = Mapping.DeviceID ?? "";
        _cameraResolution = $"{Mapping.CameraResolutionWidth}x{Mapping.CameraResolutionHeight}";
        _selectedHidProfileId = Mapping.HidProfile ?? "";
        _repeatTimeMs = Mapping.RepeatTimeMs ?? 400;
        _duplicateTimeoutSeconds = Mapping.DuplicateTimeoutSeconds;
        _selectedPgGateComponentId = Mapping.PgGateComponentId ?? "";
        _selectedPgCondGateComponentId = Mapping.PgConditionGateComponentId ?? "";

        // Ensure serial port is in list
        if (!string.IsNullOrEmpty(Mapping.RelayComPort) && !_serialPorts.Contains(Mapping.RelayComPort))
            _serialPorts = _serialPorts.Append(Mapping.RelayComPort).ToArray();
    }

