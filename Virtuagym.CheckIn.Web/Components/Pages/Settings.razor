@page "/settings"
@using Microsoft.Extensions.Options
@using Virtuagym.CheckIn.Web.Models
@using Virtuagym.CheckIn.Web.Services
@inject IOptions<AppSettings> SettingsOptions
@inject AppSettingsService SettingsService
@inject HardwareScannerService HardwareScannerService
@inject BackgroundTaskService BackgroundTaskService

<h3>@Virtuagym.CheckIn.Core.Services.L.T("Settings_Title")</h3>

<div class="settings-container">
    <!-- General settings bar (Language, Debug) -->
    <div style="display:flex; align-items:center; gap:24px; padding:12px 16px; border-bottom:1px solid var(--color-border);">
        <div class="form-group" style="margin-bottom:0;">
            <label for="appLanguage" style="width:auto; margin-right:8px;">@Virtuagym.CheckIn.Core.Services.L.T("Settings_Lbl_Language")</label>
            <select id="appLanguage" class="form-input" style="width:150px; flex:none;" value="@_settings.AppLanguage" @onchange="OnLanguageChanged">
                <option value="de">Deutsch</option>
                <option value="en">English</option>
            </select>
        </div>
    </div>

    <div class="settings-tabs">
        <button class="tab-btn @(ActiveTab == "virtuagym" ? "active" : "")" @onclick='() => ActiveTab = "virtuagym"'>@Virtuagym.CheckIn.Core.Services.L.T("Settings_Tab_VirtuagymClient")</button>
        <button class="tab-btn @(ActiveTab == "accesspass" ? "active" : "")" @onclick='() => ActiveTab = "accesspass"'>@Virtuagym.CheckIn.Core.Services.L.T("Settings_Tab_AccessPass")</button>
        <button class="tab-btn @(ActiveTab == "jablotron" ? "active" : "")" @onclick='() => ActiveTab = "jablotron"'>@Virtuagym.CheckIn.Core.Services.L.T("Settings_Tab_JablotronClient")</button>
        <button class="tab-btn @(ActiveTab == "developer" ? "active" : "")" @onclick='() => ActiveTab = "developer"'>@Virtuagym.CheckIn.Core.Services.L.T("Settings_Tab_Developer")</button>
    </div>

    <div class="tab-content">
        @if (ActiveTab == "virtuagym")
        {
            <div class="sub-tabs">
                <button class="sub-tab-btn @(SubTab == "welcome" ? "active" : "")" @onclick='() => SubTab = "welcome"'>@Virtuagym.CheckIn.Core.Services.L.T("Settings_SubTab_WelcomeScreen")</button>
                <button class="sub-tab-btn @(SubTab == "api" ? "active" : "")" @onclick='() => SubTab = "api"'>@Virtuagym.CheckIn.Core.Services.L.T("Settings_SubTab_ApiConnection")</button>
                <button class="sub-tab-btn @(SubTab == "mappings" ? "active" : "")" @onclick='() => SubTab = "mappings"'>@Virtuagym.CheckIn.Core.Services.L.T("Settings_SubTab_CheckinMappings")</button>
                <button class="sub-tab-btn @(SubTab == "services" ? "active" : "")" @onclick='() => SubTab = "services"'>@Virtuagym.CheckIn.Core.Services.L.T("Settings_SubTab_ClubServices")</button>
                <button class="sub-tab-btn @(SubTab == "members" ? "active" : "")" @onclick='() => SubTab = "members"'>@Virtuagym.CheckIn.Core.Services.L.T("Settings_SubTab_MemberTools")</button>
            </div>

            @if (SubTab == "welcome")
            {
                <Virtuagym.CheckIn.Web.Components.Controls.WelcomeScreenSettingsControl />
            }
            else if (SubTab == "api")
            {
                <Virtuagym.CheckIn.Web.Components.Controls.ApiConnectionControl />
            }
            else if (SubTab == "mappings")
            {
                <Virtuagym.CheckIn.Web.Components.Controls.CheckinMappingsControl />
            }
            else if (SubTab == "services")
            {
                <Virtuagym.CheckIn.Web.Components.Controls.ClubServicesControl />
            }
            else if (SubTab == "members")
            {
                <Virtuagym.CheckIn.Web.Components.Controls.MemberToolsControl />
            }
        }
        else if (ActiveTab == "accesspass")
        {
            <div style="padding:16px 0 24px 0; max-width:480px;">
                <h5>@Virtuagym.CheckIn.Core.Services.L.T("Settings_AccessPass_AutoDeleteTitle")</h5>
                <div class="form-group">
                <label for="deletionMode">@Virtuagym.CheckIn.Core.Services.L.T("Settings_AccessPass_AutoDeleteQuestion")</label>
                    <select id="deletionMode" class="form-input" style="width:220px;" @bind="_accessPassDeletionModeInt">
                        <option value="0">@Virtuagym.CheckIn.Core.Services.L.T("Settings_AccessPass_DeleteImmediately")</option>
                        <option value="1">@Virtuagym.CheckIn.Core.Services.L.T("Settings_AccessPass_DeleteAfterDays")</option>
                    </select>
                </div>
                @if (_accessPassDeletionModeInt == 1)
                {
                    <div class="form-group">
                        <label for="deletionDays">@Virtuagym.CheckIn.Core.Services.L.T("Settings_AccessPass_DaysUntilDelete")</label>
                        <input id="deletionDays" type="number" min="1" max="365" class="form-input" style="width:100px;" @bind="_settings.AccessPassDeletionDays" />
                    </div>
                }
            </div>
            <Virtuagym.CheckIn.Web.Components.Controls.AccessPassControl ClubSecret="@_settings.VirtuagymClubSecret" />
        }
        else if (ActiveTab == "jablotron")
        {
            <Virtuagym.CheckIn.Web.Components.Controls.JablotronClientControl />
        }
        else if (ActiveTab == "developer")
        {
            <div style="padding:12px 0;">
                <div class="form-group">
                    <label>@Virtuagym.CheckIn.Core.Services.L.T("Settings_Lbl_DebugMode")</label>
                    <input type="checkbox" @bind="_settings.DebugMode" />
                </div>
                </div>

            <div class="sub-tabs">
                <button class="sub-tab-btn @(DevSubTab == "gatetest" ? "active" : "")" @onclick='() => DevSubTab = "gatetest"'>@Virtuagym.CheckIn.Core.Services.L.T("Settings_SubTab_DeveloperJablotronGateTest")</button>
                <button class="sub-tab-btn @(DevSubTab == "simulation" ? "active" : "")" @onclick='() => DevSubTab = "simulation"'>@Virtuagym.CheckIn.Core.Services.L.T("Settings_SubTab_DeveloperSimulation")</button>
            </div>

            @if (DevSubTab == "gatetest")
            {
                <Virtuagym.CheckIn.Web.Components.Controls.DeveloperJablotronGateTestControl />
            }
            else if (DevSubTab == "simulation")
            {
                <Virtuagym.CheckIn.Web.Components.Controls.DeveloperSimulationControl />
            }
        }
    </div>

    <!-- Save / Cancel bar -->
    <div style="display:flex; align-items:center; justify-content:flex-end; gap:12px; padding:12px 16px; border-top:1px solid var(--color-border);">
        @if (!string.IsNullOrEmpty(_saveMessage))
        {
            <span class="@_saveMessageCss">@_saveMessage</span>
        }
        <button class="btn" @onclick="SaveSettings">@Virtuagym.CheckIn.Core.Services.L.T("Btn_Save")</button>
        <button class="btn btn-secondary" @onclick="CancelSettings">@Virtuagym.CheckIn.Core.Services.L.T("Btn_Cancel")</button>
    </div>
</div>

@code {
    private AppSettings _settings = new();
    private int _accessPassDeletionModeInt
    {
        get => (int)_settings.AccessPassDeletionMode;
        set => _settings.AccessPassDeletionMode = (AccessPass.Models.AccessPassDeletionMode)value;
    }
    private string ActiveTab { get; set; } = "virtuagym";
    private string SubTab { get; set; } = "welcome";
    private string DevSubTab { get; set; } = "gatetest";

    private string? _saveMessage;
    private string _saveMessageCss = "";

    protected override void OnInitialized()
    {
        _settings = SettingsOptions.Value;
    }

    private void SaveSettings()
    {
        try
        {
            SettingsService.Save(_settings);
            HardwareScannerService.Reload();
            BackgroundTaskService.Reload();
            _saveMessage = Virtuagym.CheckIn.Core.Services.L.T("Settings_Msg_SavedReloaded");
            _saveMessageCss = "text-success";
        }
        catch (Exception ex)
        {
            _saveMessage = string.Format(Virtuagym.CheckIn.Core.Services.L.T("Settings_Msg_SaveError"), ex.Message);
            _saveMessageCss = "text-error";
        }
    }

    private void CancelSettings()
    {
        Navigation.NavigateTo("/");
    }

private void OnLanguageChanged(ChangeEventArgs e)
{
    if (e.Value is string newLanguage)
    {
        _settings.AppLanguage = newLanguage;
        Virtuagym.CheckIn.Core.Services.L.Initialize(newLanguage);
        StateHasChanged();
        SaveSettings();
    }
}

    [Inject] private NavigationManager Navigation { get; set; } = default!;
}
