<Window x:Class="Virtuagym.CheckIn.WPF.WebcamCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Foto aufnehmen" Height="480" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
            <TextBlock Text="Kamera:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="cmbCamera" Width="340" SelectionChanged="cmbCamera_SelectionChanged"/>
        </StackPanel>

        <Image x:Name="imgPreview" Grid.Row="1" Stretch="Uniform"/>

        <TextBlock x:Name="txtStatus" Grid.Row="2" Text="Kamera wird gestartet..."
                   HorizontalAlignment="Center" Margin="0,6,0,6" Foreground="Gray"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
            <Button x:Name="btnCapture" Content="Aufnehmen" Width="100" Height="30" Margin="0,0,10,0" Click="btnCapture_Click" IsEnabled="False"/>
            <Button x:Name="btnCancel" Content="Abbrechen" Width="100" Height="30" Click="btnCancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
