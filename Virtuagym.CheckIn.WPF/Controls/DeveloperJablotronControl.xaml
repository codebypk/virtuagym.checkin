<UserControl x:Class="Virtuagym.CheckIn.WPF.Controls.DeveloperJablotronControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Virtuagym.CheckIn.WPF"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- F-Link Hinweis -->
        <Border Grid.Row="0" Background="#FFF8E1" BorderBrush="#FFD54F" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,5">
            <TextBlock TextWrapping="Wrap" Foreground="#5D4037" FontSize="12">
            <Run FontWeight="Bold" Foreground="#F57F17">⚠ Voraussetzung:</Run>
            Zuerst in <Bold>F-Link</Bold> (Jablotron Konfigurations-Tool) ein Backup der Zentrale erstellen:
            <Italic>Datei → Backup erstellen</Italic>. Die .fdb-Datei dann hier laden.
            </TextBlock>
        </Border>

        <!-- Dateipfad -->
        <Grid Grid.Row="1" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="lblFdbFile" Grid.Column="0" Text="FDB-Datei:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="txtJablotronDbPath" Grid.Column="1" IsReadOnly="True" VerticalAlignment="Center"
                     ToolTip="Pfad zur Jablotron ODBO-Link Datei (.fdb)"/>
            <Button x:Name="btnJablotronBrowseDb" Grid.Column="2" Content="..." Width="30" Height="22" Margin="5,0,0,0"
                    Click="btnJablotronBrowseDb_Click" ToolTip="FDB-Datei ausw&#228;hlen"/>
        </Grid>

        <!-- TabControl: Sektionen / RFID-Abgleich -->
        <TabControl Grid.Row="2">

            <!-- Tab 1: Sektionen-Browser -->
            <TabItem x:Name="tabJablonetSektionen" Header="Sektionen">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Sektions-Auswahl -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,5,0,5">
                        <Button x:Name="btnJablotronConnect" Content="Laden" Width="100" Height="28" Margin="0,0,10,0"
                                Click="btnJablotronConnect_Click" ToolTip="L&#228;dt die ODBO-Link Datei und zeigt die Sektionen an."/>
                        <TextBlock x:Name="lblJablonetSectionLabel" Text="Sektion:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="cmbJablotronTables" Width="250" VerticalAlignment="Center" Margin="0,0,10,0"
                                  SelectionChanged="cmbJablotronTables_SelectionChanged"/>
                        <TextBlock x:Name="txtJablotronTableInfo" VerticalAlignment="Center" Foreground="Gray" FontSize="12"/>
                    </StackPanel>

                    <!-- Spalteninfo -->
                    <TextBlock x:Name="txtJablotronColumns" Grid.Row="1" TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,3"/>

                    <!-- Zeilenfilter -->
                    <Grid Grid.Row="2" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="lblJablonetSearchLabel" Grid.Column="0" Text="Suche:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="txtJablotronRowFilter" Grid.Column="1" Height="24" VerticalContentAlignment="Center"
                                 TextChanged="txtJablotronRowFilter_TextChanged"
                                 ToolTip="Zeilen der aktuellen Sektion nach Inhalt filtern."/>
                        <Button Grid.Column="2" Content="&#x2716;" Width="24" Height="24" Margin="4,0,0,0" FontSize="10"
                                Click="btnJablotronRowFilterClear_Click" ToolTip="Suche l&#246;schen"/>
                        <TextBlock x:Name="txtJablotronRowFilterInfo" Grid.Column="3" VerticalAlignment="Center"
                                   Margin="10,0,0,0" Foreground="#888888" FontSize="11"/>
                    </Grid>

                    <!-- Daten-DataGrid -->
                    <DataGrid x:Name="dataGridJablotron" Grid.Row="3" AutoGenerateColumns="True" IsReadOnly="True"
                              SelectionMode="Single" CanUserAddRows="False"/>

                    <!-- Sektionssuche & Status -->
                    <Grid Grid.Row="4" Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtJablotronSql" Grid.Column="0" Height="26" VerticalContentAlignment="Center" Margin="0,0,5,0"
                                 ToolTip="Sektionsname oder Teil davon eingeben und mit 'Suchen' laden."/>
                        <Button x:Name="btnJablotronExecuteSql" Grid.Column="1" Content="Suchen" Width="80" Height="26"
                                Click="btnJablotronExecuteSql_Click" ToolTip="Sucht eine Sektion nach Name und zeigt deren Daten an."/>
                        <TextBlock x:Name="txtJablotronStatus" Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0"
                                   Foreground="Gray" FontSize="12"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Tab 2: RFID-Abgleich -->
            <TabItem x:Name="tabJablonetRfidAbgleich" Header="RFID-Abgleich">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="#333333" FontSize="12" Margin="0,5,0,5">
                        Zuordnung per <Bold>Vorname + Nachname</Bold>. Vergleicht nur <Bold>aktive</Bold> Virtuagym-Member
                        mit Jablotron-Benutzern die eine <Bold>AccessCard1</Bold> haben. Gewünschte Einträge auswählen und
                        mit "Ausgewählte aktualisieren" den RFID-Tag im Cache und in Virtuagym (API) korrigieren.
                    </TextBlock>

                    <!-- Buttons -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,5">
                        <Button x:Name="btnJablotronCompareRfid" Content="Abgleich starten" Width="140" Height="28" Margin="0,0,8,0"
                                Click="btnJablotronCompareRfid_Click"
                                ToolTip="L&#228;dt die FDB-Datei und vergleicht die RFID-Tags mit dem Virtuagym-Cache (Zuordnung per Vorname+Nachname)."/>
                        <Button x:Name="btnJablotronSelectAll" Content="Alle ausw&#228;hlen" Width="110" Height="28" Margin="0,0,8,0"
                                Click="btnJablotronSelectAll_Click" IsEnabled="False"/>
                        <Button x:Name="btnJablotronSelectNone" Content="Keine ausw&#228;hlen" Width="110" Height="28" Margin="0,0,8,0"
                                Click="btnJablotronSelectNone_Click" IsEnabled="False"/>
                        <Button x:Name="btnJablotronUpdateSelected" Content="&#x1F4BE; Ausgewählte aktualisieren" Width="200" Height="28" Margin="0,0,8,0"
                                Click="btnJablotronUpdateSelected_Click" IsEnabled="False"
                                ToolTip="Aktualisiert den RFID-Tag der ausgew&#228;hlten Member im lokalen Cache und per Virtuagym API."/>
                        <Button x:Name="btnJablotronExportCsv" Content="&#x1F4CB; CSV Export" Width="110" Height="28" Margin="0,0,8,0"
                                Click="btnJablotronExportCsv_Click" IsEnabled="False"
                                ToolTip="Exportiert die aktuelle (gefilterte) Liste als CSV-Datei."/>
                        <TextBlock x:Name="txtJablotronCompareStatus" VerticalAlignment="Center" Foreground="Gray" FontSize="12"/>
                    </StackPanel>

                    <!-- Such- und Statusfilter -->
                    <Grid Grid.Row="2" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="lblJablonetFilterLabel" Grid.Column="0" Text="&#x1F50D; Filter:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="txtJablotronCompareFilter" Grid.Column="1" Height="24" VerticalContentAlignment="Center"
                                 TextChanged="txtJablotronCompareFilter_TextChanged"
                                 ToolTip="Liste nach Name oder Kartennummer filtern."/>
                        <Button Grid.Column="2" Content="&#x2716;" Width="24" Height="24" Margin="4,0,0,0" FontSize="10"
                                Click="btnJablotronCompareFilterClear_Click" ToolTip="Filter l&#246;schen"/>
                        <TextBlock x:Name="lblJablonetStatusLabel" Grid.Column="3" Text="Status:" VerticalAlignment="Center" Margin="12,0,6,0"/>
                        <ComboBox x:Name="cmbJablotronStatusFilter" Grid.Column="4" Width="160" Height="24" VerticalContentAlignment="Center"
                                  SelectionChanged="cmbJablotronStatusFilter_SelectionChanged"
                                  ToolTip="Ergebnisse nach Status filtern.">
                            <ComboBoxItem Content="Alle" Tag="" IsSelected="True"/>
                            <ComboBoxItem Content="&#x2705; OK" Tag="OK"/>
                            <ComboBoxItem Content="&#x274C; RFID abweichend" Tag="RFID abweichend"/>
                            <ComboBoxItem Content="&#x26A0; Nicht eindeutig" Tag="Nicht eindeutig"/>
                            <ComboBoxItem Content="&#x2753; Nicht zugeordnet" Tag="Nicht zugeordnet"/>
                        </ComboBox>
                        <TextBlock x:Name="txtJablotronCompareFilterInfo" Grid.Column="5" VerticalAlignment="Center"
                                   Margin="10,0,0,0" Foreground="#888888" FontSize="11"/>
                    </Grid>

                    <!-- Ergebnis-DataGrid -->
                    <DataGrid x:Name="dataGridJablotronCompare" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="False"
                              SelectionMode="Extended" CanUserAddRows="False" CanUserDeleteRows="False">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="&#x2714;" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="35"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="OK">
                                                <Setter Property="Foreground" Value="Green"/>
                                                <Setter Property="FontWeight" Value="Normal"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="RFID abweichend">
                                                <Setter Property="Foreground" Value="Red"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Nicht zugeordnet">
                                                <Setter Property="Foreground" Value="#888888"/>
                                                <Setter Property="FontWeight" Value="Normal"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Nicht eindeutig">
                                                <Setter Property="Foreground" Value="#FF8C00"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Member-ID" Binding="{Binding VirtuagymMemberId}" Width="80" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Virtuagym Member" Binding="{Binding VirtuagymName}" Width="170" IsReadOnly="True"/>
                                <DataGridCheckBoxColumn Header="VG Aktiv" Binding="{Binding VirtuagymActive}" Width="70" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Virtuagym RFID" Binding="{Binding VirtuagymRfidTag}" Width="110" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Jablotron Name" Binding="{Binding JablotronName}" Width="170" IsReadOnly="True"/>
                                <DataGridCheckBoxColumn Header="Jab Aktiv" Binding="{Binding JablotronActive}" Width="70" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Jablotron Karte" Binding="{Binding JablotronAccessCard}" Width="110" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Info" Binding="{Binding MatchInfo}" Width="*" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#555555"/>
                                        <Setter Property="FontSize" Value="11"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Zusammenfassung -->
                    <TextBlock x:Name="txtJablotronCompareSummary" Grid.Row="4" TextWrapping="Wrap" Foreground="#666666" FontSize="11" Margin="0,5,0,0"/>

                    <!-- Fortschritt bei Update -->
                    <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,3,0,0">
                        <ProgressBar x:Name="progressJablotronUpdate" Width="300" Height="18" Margin="0,0,10,0" Visibility="Collapsed"/>
                        <TextBlock x:Name="txtJablotronUpdateProgress" Foreground="Gray" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>