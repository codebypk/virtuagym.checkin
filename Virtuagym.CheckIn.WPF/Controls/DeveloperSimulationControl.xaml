<UserControl x:Class="Virtuagym.CheckIn.WPF.Controls.DeveloperSimulationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Virtuagym.CheckIn.WPF"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800" Background="White">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <GroupBox x:Name="grpSimulation" Grid.Row="0" Header="Checkin-Simulation" Margin="0,0,0,10">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="lblSimMapping" Grid.Row="1" Grid.Column="0" Text="Checkin-Client Mapping:" VerticalAlignment="Center" Margin="0,5"/>
                <ComboBox x:Name="cmbSimulationMapping" Grid.Row="1" Grid.Column="1" Width="400" HorizontalAlignment="Left" Margin="0,5"/>

                <TextBlock x:Name="lblSimCardId" Grid.Row="2" Grid.Column="0" Text="Card-ID / QR-Code / MemberId:" VerticalAlignment="Center" Margin="0,5"/>
                <TextBox x:Name="txtSimulationCardId" Grid.Row="2" Grid.Column="1" Width="400" HorizontalAlignment="Left" Margin="0,5"
                         KeyDown="txtSimulationCardId_KeyDown" Text="0005546808"/>

                <CheckBox x:Name="chkSimByMemberId" Grid.Row="3" Grid.Column="1" Margin="0,5"/>
                <CheckBox x:Name="chkSimulationClearCache" Grid.Row="4" Grid.Column="1" Margin="0,5"/>
                <CheckBox x:Name="chkForceOffline" Grid.Row="5" Grid.Column="1" Margin="0,5"/>

                <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,5">
                    <Button x:Name="btnSimulationRun"
                            Click="btnSimulationRun_Click"/>
                    <Button x:Name="btnSimulationClearLog" Content="Log leeren" Width="100" Height="28"
                            Click="btnSimulationClearLog_Click"/>
                    <TextBlock x:Name="txtSimulationStatus" VerticalAlignment="Center" Foreground="Gray" FontSize="12" Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <TextBlock x:Name="lblSimLog" Grid.Row="1" Text="Simulations-Log:" FontWeight="SemiBold" Margin="0,0,0,5"/>

        <ListView x:Name="listViewSimulationLog" Grid.Row="2" ScrollViewer.VerticalScrollBarVisibility="Visible">
            <ListView.View>
                <GridView>
                    <GridViewColumn x:Name="colSimLog" Header="Log" Width="900"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</UserControl>
