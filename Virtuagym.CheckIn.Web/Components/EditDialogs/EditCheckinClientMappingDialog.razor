@* Full edit dialog for CheckinClientMapping – WPF parity *@
@using Microsoft.Extensions.Options
@using Virtuagym.CheckIn.Web.Models
@using Virtuagym.CheckIn.Core.Models
@using Virtuagym.CheckIn.Core.Services
@using Hardware.Models
@using Hardware.Services
@using HidLibrary
@using System.IO.Ports
@using System.Text.RegularExpressions
@using OpenCvSharp
@using Virtuagym.API
@implements IDisposable
@inject IOptions<AppSettings> SettingsOptions

<div class="modal-overlay visible" style="position:fixed; inset:0; background:rgba(0,0,0,0.45); z-index:1000; display:flex; align-items:center; justify-content:center;">
    <div style="background:#fff; border-radius:8px; width:max-content; max-height:90vh; overflow:auto; box-shadow:0 8px 32px rgba(0,0,0,0.25); padding:0;">
        <div style="display:flex; justify-content:space-between; align-items:center; padding:14px 20px; border-bottom:1px solid #ddd;">
            <h4 style="margin:0;">@(IsNew ? L.T("Web_EditMapping_Title_New") : L.T("Web_EditMapping_Title_Edit"))</h4>
            <button style="background:none; border:none; font-size:20px; cursor:pointer;" @onclick="Cancel">&times;</button>
        </div>

        <div style="padding:16px 20px;">
            @* ──── Tab buttons ──── *@
            <div class="sub-tabs" style="margin-bottom:14px;">
                <button class="sub-tab-btn @(_tab == "general" ? "active" : "")" @onclick='() => _tab = "general"'>@L.T("Web_EditMapping_Tab_General")</button>
                <button class="sub-tab-btn @(_tab == "test" ? "active" : "")" @onclick='() => _tab = "test"'>@L.T("Web_EditMapping_Tab_DeviceTest")</button>
                <button class="sub-tab-btn @(_tab == "relay" ? "active" : "")" @onclick='() => _tab = "relay"'>@L.T("Web_EditMapping_Tab_Relay")</button>
                <button class="sub-tab-btn @(_tab == "pg" ? "active" : "")" @onclick='() => _tab = "pg"'>@L.T("Web_EditMapping_Tab_JablotronPG")</button>
            </div>

            @* ════════════════════════════════════════════ *@
            @*  Tab 1: Allgemein                            *@
            @* ════════════════════════════════════════════ *@
            @if (_tab == "general")
            {
                <fieldset style="margin-bottom:12px; padding:10px; border:1px solid #ddd; border-radius:4px;">
                    <legend style="font-weight:600;">@L.T("Web_EditMapping_Grp_Device")</legend>
                    <div style="display:grid; grid-template-columns:160px 1fr; gap:6px 12px;">
                        <label>Name:</label>
                        <input type="text" class="form-input" @bind="Mapping.Name" @bind:event="oninput" title="@L.T("Web_EditMapping_Tip_Name")" />

                        <label>@L.T("Web_EditMapping_Lbl_InputType")</label>
                        <select class="form-input" style="width:220px;" @bind="Mapping.InputType">
                            <option value="@CheckinClientMapping.InputTypeRfid">@L.T("Web_EditMapping_Type_UsbReader")</option>
                            <option value="@CheckinClientMapping.InputTypeQrCode">@L.T("Web_EditMapping_Type_QrCamera")</option>
                            <option value="@CheckinClientMapping.InputTypeCcid">@L.T("Web_EditMapping_Type_Ccid")</option>
                        </select>

                        @if (Mapping.InputType != CheckinClientMapping.InputTypeQrCode)
                        {
                            <label>USB Device:</label>
                            <div style="display:flex; gap:4px; align-items:center;">
                                <select class="form-input" style="flex:1; min-width:0; overflow:hidden; text-overflow:ellipsis;" @bind="_selectedDeviceId">
                                    <option value="">@L.T("Web_EditMapping_Select_ManualInput")</option>
                                    @foreach (var d in GetFilteredHidDevices())
                                    {
                                        <option value="@d.DeviceId">@d.DisplayName</option>
                                    }
                                </select>
                                <button type="button" class="btn btn-sm" @onclick="RefreshDevices" title="@L.T("Web_EditMapping_Tip_RefreshDevices")">🔄</button>
                            </div>
                            @if (string.IsNullOrEmpty(_selectedDeviceId))
                            {
                                <label>@L.T("Web_EditMapping_Lbl_DeviceId")</label>
                                <input type="text" class="form-input" @bind="Mapping.DeviceID" placeholder="@L.T("Web_EditMapping_Placeholder_DeviceId")" />
                            }
                        }
                        else
                        {
                            <label>@L.T("Web_EditMapping_Lbl_Camera")</label>
                            <select class="form-input" style="width:320px;" @bind="Mapping.CameraIndex">
                                @foreach (var cam in _cameras)
                                {
                                    <option value="@cam.Index">@cam.DisplayName</option>
                                }
                            </select>

                            <label>@L.T("Web_EditMapping_Lbl_Resolution")</label>
                            <select class="form-input" style="width:220px;" @bind="_cameraResolution">
                                <option value="640x480">640 × 480</option>
                                <option value="1280x720">1280 × 720 (HD)</option>
                                <option value="1920x1080">1920 × 1080 (Full HD)</option>
                                <option value="2560x1440">2560 × 1440 (QHD)</option>
                                <option value="3840x2160">3840 × 2160 (Ultra HD)</option>
                            </select>

                            <label>@L.T("Web_EditMapping_Lbl_VideoBackend")</label>
                            <select class="form-input" style="width:340px;" @bind="Mapping.CameraBackend">
                                @foreach (var backend in _cameraBackends)
                                {
                                    <option value="@backend.Key">@backend.Value</option>
                                }
                            </select>
                        }

                        @if (Mapping.InputType == CheckinClientMapping.InputTypeQrCode)
                        {
                            <div style="grid-column:1/-1; margin-top:8px;">
                                <div style="display:flex; gap:8px; align-items:center; margin-bottom:6px;">
                                    <button class="btn btn-sm" @onclick="ToggleCameraPreview">
                                        @(_cameraPreviewRunning ? L.T("Web_EditMapping_Btn_StopPreview") : L.T("Web_EditMapping_Btn_CameraPreview"))
                                    </button>
                                    @if (!string.IsNullOrEmpty(_cameraPreviewStatus))
                                    {
                                        <span class="text-muted" style="font-size:12px;">@_cameraPreviewStatus</span>
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(_cameraPreviewBase64))
                                {
                                    <div style="border:1px solid #ddd; padding:4px; background:#000; display:inline-block; border-radius:4px;">
                                        <img src="data:image/jpeg;base64,@_cameraPreviewBase64" alt="@L.T("Web_EditMapping_Btn_CameraPreview")"
                                             style="max-width:480px; max-height:360px; display:block;" />
                                    </div>
                                }
                            </div>
                        }

                        @if (Mapping.InputType == CheckinClientMapping.InputTypeRfid)
                        {
                            <label>Repeat time (ms):</label>
                            <input type="number" class="form-input" style="width:120px;" @bind="_repeatTimeMs" />

                            <label>@L.T("Web_EditMapping_Lbl_ReaderProfile")</label>
                            <select class="form-input" style="width:280px;" @bind="_selectedHidProfileId">
                                @foreach (var p in _hidProfiles)
                                {
                                    <option value="@p.ProfileId">@p.DisplayName</option>
                                }
                            </select>
                        }
                    </div>
                </fieldset>

                <fieldset style="padding:10px; border:1px solid #ddd; border-radius:4px;">
                    <legend style="font-weight:600;">@L.T("Web_EditMapping_Grp_VirtuagymSettings")</legend>
                    <div style="display:grid; grid-template-columns:160px 1fr; gap:6px 12px;">
                        <label>Check-In Key:</label>
                        <input type="text" class="form-input" @bind="Mapping.CheckinKey" @bind:event="oninput" />

                        <label>@L.T("Web_EditMapping_Lbl_ApiMode")</label>
                        @{
                            var _apiDevId = VirtuagymApiBase.ExtractDeviceId(Mapping.CheckinKey?.Trim() ?? "");
                            var _apiSlug = CheckinClientMapping.ToDeviceIdSlug(Mapping.Name?.Trim() ?? "");
                        }
                        @if (!string.IsNullOrEmpty(_apiDevId))
                        {
                            <span style="font-size:12px; color:green;" title="@L.T("Web_EditMapping_Tip_V0_HasDeviceId")">
                                @string.Format(L.T("Web_EditMapping_ApiMode_V0_DeviceId"), _apiDevId)
                            </span>
                        }
                        else if (!string.IsNullOrWhiteSpace(Mapping.CheckinKey)
                                 && Mapping.CheckinKey.Contains("CHECKIN", StringComparison.OrdinalIgnoreCase))
                        {
                            <span style="font-size:12px; color:red;" title="@L.T("Web_EditMapping_Tip_V0_Warn")">
                                @L.T("Web_EditMapping_ApiMode_V0_NoDeviceId")
                            </span>
                        }
                        else
                        {
                            <span style="font-size:12px; color:steelblue;" title="@L.T("Web_EditMapping_Tip_V1")">
                                @string.Format(L.T("Web_EditMapping_ApiMode_V1_Slug"), !string.IsNullOrEmpty(_apiSlug) ? _apiSlug : L.T("Web_EditMapping_ApiMode_V1_NoName"))
                            </span>
                        }

                        <label>@L.T("Web_EditMapping_Lbl_DoubleScan")</label>
                        <select class="form-input" style="width:200px;" @bind="Mapping.DoubleScanThresholdMs">
                            <option value="0">@L.T("Web_EditMapping_Disabled")</option>
                            <option value="5000">@L.T("Web_EditMapping_DS_5s")</option>
                            <option value="15000">@L.T("Web_EditMapping_DS_15s")</option>
                            <option value="30000">@L.T("Web_EditMapping_DS_30s")</option>
                            <option value="60000">@L.T("Web_EditMapping_DS_1m")</option>
                            <option value="120000">@L.T("Web_EditMapping_DS_2m")</option>
                            <option value="300000">@L.T("Web_EditMapping_DS_5m")</option>
                            <option value="600000">@L.T("Web_EditMapping_DS_10m")</option>
                            <option value="900000">@L.T("Web_EditMapping_DS_15m")</option>
                            <option value="1800000">@L.T("Web_EditMapping_DS_30m")</option>
                        </select>

                        <label>@L.T("Web_EditMapping_Lbl_Service")</label>
                        <select class="form-input" @bind="Mapping.CreditServiceId">
                            <option value="">@L.T("Web_EditMapping_Disabled")</option>
                            @foreach (var svc in _creditServices)
                            {
                                <option value="@svc.service_id">@svc.DisplayName</option>
                            }
                        </select>

                        <label>@L.T("Web_EditMapping_Lbl_AutoCheckout")</label>
                        <select class="form-input" style="width:200px;" @bind="Mapping.AutoCheckoutMinutes">
                            <option value="0">@L.T("Web_EditMapping_Disabled")</option>
                            <option value="1">@L.T("Web_EditMapping_AC_1m")</option>
                            <option value="5">@L.T("Web_EditMapping_AC_5m")</option>
                            <option value="15">@L.T("Web_EditMapping_AC_15m")</option>
                            <option value="30">@L.T("Web_EditMapping_AC_30m")</option>
                            <option value="60">@L.T("Web_EditMapping_AC_1h")</option>
                            <option value="120">@L.T("Web_EditMapping_AC_2h")</option>
                            <option value="240">@L.T("Web_EditMapping_AC_4h")</option>
                            <option value="480">@L.T("Web_EditMapping_AC_8h")</option>
                            <option value="720">@L.T("Web_EditMapping_AC_12h")</option>
                        </select>

                        <label>@L.T("Web_EditMapping_Lbl_DuplicateTimeout")</label>
                        <input type="number" class="form-input" style="width:100px;" @bind="_duplicateTimeoutSeconds"
                               placeholder="@(SettingsOptions.Value.DuplicateTimeoutSeconds)"
                               title="@string.Format(L.T("Web_EditMapping_Tip_DuplicateTimeout"), SettingsOptions.Value.DuplicateTimeoutSeconds)" />

                        @if (Mapping.InputType != CheckinClientMapping.InputTypeQrCode)
                        {
                            <label>@L.T("Web_EditMapping_Lbl_CardIdMode")</label>
                            <select class="form-input" style="width:380px;" @bind="Mapping.CardIdMode">
                                <option value="0">@L.T("Web_EditMapping_CardIdMode_Standard")</option>
                                <option value="1">@L.T("Web_EditMapping_CardIdMode_FullDecimal")</option>
                                <option value="2">@L.T("Web_EditMapping_CardIdMode_FullHex")</option>
                                <option value="3">@L.T("Web_EditMapping_CardIdMode_Mifare")</option>
                            </select>
                        }
                    </div>
                </fieldset>
            }

            @* ════════════════════════════════════════════ *@
            @*  Tab 2: Geräte-Test                          *@
            @* ════════════════════════════════════════════ *@
            else if (_tab == "test")
            {
                <fieldset style="padding:10px; border:1px solid #ddd; border-radius:4px;">
                    <legend style="font-weight:600;">@L.T("Web_EditMapping_Grp_DeviceTest")</legend>

                    @if (Mapping.InputType == CheckinClientMapping.InputTypeRfid)
                    {
                        <div style="display:flex; gap:8px; margin-bottom:8px;">
                            <button class="btn btn-sm" @onclick="TestBeep" disabled="@_testRunning" title="@L.T("Web_EditMapping_Tip_Beep")">Beep</button>
                            <button class="btn btn-sm" @onclick="TestRead" disabled="@_testRunning" title="@L.T("Web_EditMapping_Tip_ReadCard")">@L.T("EditMapping_Btn_ReadCard")</button>
                        </div>
                    }
                    else if (Mapping.InputType == CheckinClientMapping.InputTypeQrCode)
                    {
                        <div style="display:flex; gap:8px; margin-bottom:8px;">
                            <button class="btn btn-sm" @onclick="StartQrScanTest" disabled="@_qrTestRunning"
                                    title="@L.T("Web_EditMapping_Tip_QrScan")">
                                @L.T("EditMapping_Btn_QrScan")
                            </button>
                            <button class="btn btn-sm" @onclick="StopQrScanTest" disabled="@(!_qrTestRunning)"
                                    title="@L.T("Web_EditMapping_Tip_QrStop")">
                                @L.T("EditMapping_Btn_Stop")
                            </button>
                        </div>

                        @if (!string.IsNullOrEmpty(_qrTestStatus))
                        {
                            <p class="text-muted" style="margin:4px 0;">@_qrTestStatus</p>
                        }

                        @if (!string.IsNullOrEmpty(_qrTestPreviewBase64))
                        {
                            <div style="border:2px solid #ccc; background:#222; display:inline-block; border-radius:8px; padding:8px; margin:6px 0; position:relative;">
                                <div style="margin-bottom:6px; display:flex; align-items:center; gap:8px;">
                                    <span style="background:#4CAF50; color:white; font-weight:bold; font-size:11px; padding:2px 8px; border-radius:4px;">@L.T("Web_EditMapping_Lbl_CameraPreviewLabel")</span>
                                    <span style="color:#999; font-size:11px;">@L.T("Web_EditMapping_Lbl_QrScannerTest")</span>
                                </div>
                                <img src="data:image/jpeg;base64,@_qrTestPreviewBase64" alt="@L.T("Web_EditMapping_Btn_CameraPreview")"
                                     style="max-width:480px; max-height:360px; display:block; border-radius:4px;" />
                                <p style="color:#999; font-size:11px; font-style:italic; text-align:center; margin:6px 0 0;">@L.T("Web_EditMapping_PositionQrCode")</p>
                            </div>
                        }
                    }

                    @if (!string.IsNullOrEmpty(_testResult))
                    {
                        <p style="color:@_testResultColor; white-space:pre-line; font-size:13px;">@_testResult</p>
                    }

                    <hr style="margin:12px 0;" />
                    <strong>@L.T("Web_EditMapping_Lbl_CheckinTest")</strong>
                    <div style="display:flex; gap:8px; margin-top:6px;">
                        <input type="text" class="form-input" style="flex:1; min-width:0;" @bind="_testCardId" placeholder="@L.T("Web_EditMapping_Placeholder_CardId")" />
                        <button class="btn btn-sm" style="white-space:nowrap;" @onclick="TestCheckin">@L.T("Web_EditMapping_Btn_TestCheckin")</button>
                    </div>
                    @if (!string.IsNullOrEmpty(_checkinTestResult))
                    {
                        <p class="text-muted" style="margin-top:6px;">@_checkinTestResult</p>
                    }
                </fieldset>
            }

            @* ════════════════════════════════════════════ *@
            @*  Tab 3: Relay                                *@
            @* ════════════════════════════════════════════ *@
            else if (_tab == "relay")
            {
                <fieldset style="padding:10px; border:1px solid #ddd; border-radius:4px;">
                    <legend style="font-weight:600;">Relay</legend>
                    <div style="display:grid; grid-template-columns:160px 1fr; gap:6px 12px;">
                        <label>@L.T("Web_EditMapping_Lbl_RelayEnabled")</label>
                        <input type="checkbox" @bind="Mapping.RelayEnabled" />

                        <label>@L.T("Web_EditMapping_Lbl_RelayComPort")</label>
                        <select class="form-input" style="width:140px;" @bind="Mapping.RelayComPort" disabled="@(!Mapping.RelayEnabled)">
                            <option value="">@L.T("Web_EditMapping_Select_NoPort")</option>
                            @foreach (var port in _serialPorts)
                            {
                                <option value="@port">@port</option>
                            }
                        </select>

                        <label>Baudrate:</label>
                        <select class="form-input" style="width:140px;" @bind="Mapping.RelayBaudRate" disabled="@(!Mapping.RelayEnabled)">
                            <option value="1200">1200</option>
                            <option value="2400">2400</option>
                            <option value="4800">4800</option>
                            <option value="9600">9600</option>
                            <option value="19200">19200</option>
                            <option value="38400">38400</option>
                            <option value="57600">57600</option>
                            <option value="115200">115200</option>
                        </select>

                        <label>@L.T("Web_EditMapping_Lbl_RelayNumber")</label>
                        <select class="form-input" style="width:80px;" @bind="Mapping.RelayNumber" disabled="@(!Mapping.RelayEnabled)">
                            @for (int i = 1; i <= 8; i++)
                            {
                                <option value="@i">@i</option>
                            }
                        </select>

                        <label>@L.T("Web_EditMapping_Lbl_SwitchTime")</label>
                        <select class="form-input" style="width:100px;" @bind="Mapping.RelayTriggerTime" disabled="@(!Mapping.RelayEnabled)">
                            <option value="0.05">0.05</option>
                            <option value="0.5">0.5</option>
                            <option value="1">1</option>
                            <option value="2">2</option>
                            <option value="3">3</option>
                            <option value="5">5</option>
                            <option value="10">10</option>
                            <option value="15">15</option>
                            <option value="30">30</option>
                            <option value="60">60</option>
                        </select>
                    </div>
                    <div style="margin-top:10px;">
                        <button class="btn btn-sm" @onclick="TestRelay" disabled="@(!Mapping.RelayEnabled)">@L.T("Web_EditMapping_Btn_TestRelay")</button>
                        @if (!string.IsNullOrEmpty(_relayTestResult))
                        {
                            <span class="text-muted" style="margin-left:8px;">@_relayTestResult</span>
                        }
                    </div>
                </fieldset>
            }

            @* ════════════════════════════════════════════ *@
            @*  Tab 4: Jablotron PG                         *@
            @* ════════════════════════════════════════════ *@
            else if (_tab == "pg")
            {
                <fieldset style="padding:10px; border:1px solid #ddd; border-radius:4px; margin-bottom:12px;">
                    <legend style="font-weight:600;">@L.T("Web_EditMapping_Grp_GateControl")</legend>
                    <div style="display:grid; grid-template-columns:160px 1fr; gap:6px 12px;">
                        <label>@L.T("Web_EditMapping_Lbl_GateEnabled")</label>
                        <input type="checkbox" @bind="Mapping.PgEnabled" />

                        <label>Programmable Gate:</label>
                        <select class="form-input" @bind="_selectedPgGateComponentId" disabled="@(!Mapping.PgEnabled)">
                                <option value="">@L.T("Web_EditMapping_Select_NoGate")</option>
                                @foreach (var g in _pgGates)
                                {
                                    <option value="@g.CloudComponentId">@g.Display</option>
                                }
                            </select>

                            <label>@L.T("Web_EditMapping_Lbl_SwitchTime")</label>
                        <select class="form-input" style="width:80px;" @bind="Mapping.PgTriggerTimeSec" disabled="@(!Mapping.PgEnabled)">
                            <option value="1">1</option>
                            <option value="2">2</option>
                            <option value="3">3</option>
                            <option value="5">5</option>
                            <option value="10">10</option>
                            <option value="15">15</option>
                            <option value="30">30</option>
                            <option value="60">60</option>
                        </select>
                    </div>
                </fieldset>

                <fieldset style="padding:10px; border:1px solid #ddd; border-radius:4px;">
                    <legend style="font-weight:600;">@L.T("Web_EditMapping_Grp_TriggerCondition")</legend>
                    <p class="text-muted" style="font-size:12px; margin-top:0;">@L.T("Web_EditMapping_Tip_TriggerCondition")</p>
                    <div style="display:grid; grid-template-columns:160px 1fr; gap:6px 12px;">
                        <label>@L.T("Web_EditMapping_Lbl_Condition")</label>
                        <select class="form-input" style="width:260px;" @bind="Mapping.PgConditionMode" disabled="@(!Mapping.PgEnabled)">
                            <option value="Always">@L.T("Web_EditMapping_Cond_Always")</option>
                            <option value="OnlyIfOn">@L.T("Web_EditMapping_Cond_OnlyIfOn")</option>
                            <option value="OnlyIfOff">@L.T("Web_EditMapping_Cond_OnlyIfOff")</option>
                            <option value="TimeRange">@L.T("Web_EditMapping_Cond_TimeRange")</option>
                        </select>

                        @if (Mapping.PgConditionMode == "OnlyIfOn" || Mapping.PgConditionMode == "OnlyIfOff")
                        {
                            <label>@L.T("Web_EditMapping_Lbl_ConditionGate")</label>
                            <select class="form-input" @bind="_selectedPgCondGateComponentId" disabled="@(!Mapping.PgEnabled)">
                                <option value="">@L.T("Web_EditMapping_Select_NoGate")</option>
                                @foreach (var g in _pgGates)
                                {
                                    <option value="@g.CloudComponentId">@g.Display</option>
                                }
                            </select>
                        }

                        @if (Mapping.PgConditionMode == "TimeRange")
                        {
                            <label>@L.T("Web_EditMapping_Lbl_From")</label>
                            <input type="text" class="form-input" style="width:80px;" @bind="Mapping.PgConditionTimeFrom"
                                   placeholder="06:00" disabled="@(!Mapping.PgEnabled)" />

                            <label>@L.T("Web_EditMapping_Lbl_To")</label>
                            <input type="text" class="form-input" style="width:80px;" @bind="Mapping.PgConditionTimeTo"
                                   placeholder="22:00" disabled="@(!Mapping.PgEnabled)" />
                        }
                    </div>
                </fieldset>

                <div style="display:flex; gap:10px; margin-top:10px;">
                    <button class="btn btn-sm" @onclick="ReloadPgGates">@L.T("Web_EditMapping_Btn_LoadGates")</button>
                    <button class="btn btn-sm" @onclick="TestPgGate" disabled="@(!Mapping.PgEnabled || string.IsNullOrEmpty(_selectedPgGateComponentId))">@L.T("Web_EditMapping_Btn_TestGate")</button>
                    @if (!string.IsNullOrEmpty(_pgStatus))
                    {
                        <span class="text-muted">@_pgStatus</span>
                    }
                </div>
            }
        </div>

        @* ──── Footer ──── *@
        <div style="display:flex; justify-content:flex-end; gap:10px; padding:12px 20px; border-top:1px solid #ddd;">
            @if (!string.IsNullOrEmpty(_validationError))
            {
                <span style="color:red; margin-right:auto;">@_validationError</span>
            }
            <button class="btn" @onclick="Save">@L.T("Web_EditMapping_Btn_Apply")</button>
            <button class="btn btn-secondary" @onclick="Cancel">@L.T("Btn_Cancel")</button>
        </div>
    </div>
</div>

@code {
    [Parameter] public CheckinClientMapping Mapping { get; set; } = new();
    [Parameter] public bool IsNew { get; set; }
    [Parameter] public List<HidDeviceInfo> AvailableHidDevices { get; set; } = new();
    [Parameter] public HashSet<string> UsedDeviceIds { get; set; } = new();
    [Parameter] public EventCallback<CheckinClientMapping> OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnRefreshDevices { get; set; }

    private string _tab = "general";

    // General tab state
    private string _selectedDeviceId = "";
    private string _cameraResolution = "640x480";
    private string _selectedHidProfileId = "";
    private int? _repeatTimeMs;
    private int? _duplicateTimeoutSeconds;
    private List<CameraDeviceInfo> _cameras = new();
