<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
	<TargetFramework>net10.0-windows</TargetFramework>
	<RootNamespace>Virtuagym.CheckIn.Web</RootNamespace>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
	<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Resources\**" />
    <Content Remove="Resources\**" />
    <EmbeddedResource Remove="Resources\**" />
    <None Remove="Resources\**" />
    <Content Include="..\Resources\data\**" Link="Resources\data\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Resources\lang\**" Link="Resources\lang\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Resources\sounds\**" Link="Resources\sounds\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Resources\backgrounds\**" Link="Resources\backgrounds\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="appsettings.json.template" />
  </ItemGroup>
  <ItemGroup>
	<ProjectReference Include="..\Virtuagym.API\Virtuagym.API.csproj" />
	<ProjectReference Include="..\Virtuagym.CheckIn.Core\Virtuagym.CheckIn.Core.csproj" />
	<ProjectReference Include="..\Jablotron.API\Jablotron.API.csproj" />
	<ProjectReference Include="..\Hardware\Hardware.csproj" />
	<ProjectReference Include="..\AccessPass\AccessPass.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260302" />
    <PackageReference Include="OpenCvSharp4.official.runtime.linux-x64" Version="4.13.0.20260329" />
  </ItemGroup>
</Project>
