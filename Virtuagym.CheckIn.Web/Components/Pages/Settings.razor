@page "/settings"
@using Microsoft.Extensions.Options
@using Virtuagym.CheckIn.Web.Models
@using Virtuagym.CheckIn.Web.Services
@inject IOptions<AppSettings> SettingsOptions
@inject AppSettingsService SettingsService
@inject HardwareScannerService HardwareScannerService
@inject BackgroundTaskService BackgroundTaskService

<h3>Settings</h3>

<div class="settings-container">
    <!-- General settings bar (Language, Debug) -->
    <div style="display:flex; align-items:center; gap:24px; padding:12px 16px; border-bottom:1px solid var(--color-border);">
        <div class="form-group" style="margin-bottom:0;">
            <label style="width:auto; margin-right:8px;">Sprache:</label>
            <select @bind="_settings.AppLanguage" class="form-input" style="width:150px; flex:none;">
                <option value="de">Deutsch</option>
                <option value="en">English</option>
            </select>
        </div>
    </div>

    <div class="settings-tabs">
        <button class="tab-btn @(ActiveTab == "virtuagym" ? "active" : "")" @onclick='() => ActiveTab = "virtuagym"'>Virtuagym Client</button>
        <button class="tab-btn @(ActiveTab == "accesspass" ? "active" : "")" @onclick='() => ActiveTab = "accesspass"'>Access Pass</button>
        <button class="tab-btn @(ActiveTab == "jablotron" ? "active" : "")" @onclick='() => ActiveTab = "jablotron"'>Jablotron Client</button>
        <button class="tab-btn @(ActiveTab == "developer" ? "active" : "")" @onclick='() => ActiveTab = "developer"'>Developer</button>
    </div>

    <div class="tab-content">
        @if (ActiveTab == "virtuagym")
        {
            <div class="sub-tabs">
                <button class="sub-tab-btn @(SubTab == "welcome" ? "active" : "")" @onclick='() => SubTab = "welcome"'>Welcome Screen</button>
                <button class="sub-tab-btn @(SubTab == "api" ? "active" : "")" @onclick='() => SubTab = "api"'>API Connection</button>
                <button class="sub-tab-btn @(SubTab == "mappings" ? "active" : "")" @onclick='() => SubTab = "mappings"'>Checkin-Client Mappings</button>
                <button class="sub-tab-btn @(SubTab == "services" ? "active" : "")" @onclick='() => SubTab = "services"'>Club Services</button>
                <button class="sub-tab-btn @(SubTab == "members" ? "active" : "")" @onclick='() => SubTab = "members"'>Member-Tools</button>
            </div>

            @if (SubTab == "welcome")
            {
                <Virtuagym.CheckIn.Web.Components.Controls.WelcomeScreenSettingsControl />
            }
            else if (SubTab == "api")
            {
                <Virtuagym.CheckIn.Web.Components.Controls.ApiConnectionControl />
            }
            else if (SubTab == "mappings")
            {
                <Virtuagym.CheckIn.Web.Components.Controls.CheckinMappingsControl />
            }
            else if (SubTab == "services")
            {
                <Virtuagym.CheckIn.Web.Components.Controls.ClubServicesControl />
            }
            else if (SubTab == "members")
            {
                <Virtuagym.CheckIn.Web.Components.Controls.MemberToolsControl />
            }
        }
        else if (ActiveTab == "accesspass")
        {
            <Virtuagym.CheckIn.Web.Components.Controls.AccessPassControl ClubSecret="@_settings.VirtuagymClubSecret" />
        }
        else if (ActiveTab == "jablotron")
        {
            <Virtuagym.CheckIn.Web.Components.Controls.JablotronClientControl />
        }
        else if (ActiveTab == "developer")
        {
            <div style="padding:12px 0;">
                <div class="form-group">
                    <label>Debug Mode:</label>
                    <input type="checkbox" @bind="_settings.DebugMode" />
                </div>
                </div>

            <div class="sub-tabs">
                <button class="sub-tab-btn @(DevSubTab == "gatetest" ? "active" : "")" @onclick='() => DevSubTab = "gatetest"'>Gate Test</button>
                <button class="sub-tab-btn @(DevSubTab == "simulation" ? "active" : "")" @onclick='() => DevSubTab = "simulation"'>Simulation</button>
            </div>

            @if (DevSubTab == "gatetest")
            {
                <Virtuagym.CheckIn.Web.Components.Controls.DeveloperJablotronGateTestControl />
            }
            else if (DevSubTab == "simulation")
            {
                <Virtuagym.CheckIn.Web.Components.Controls.DeveloperSimulationControl />
            }
        }
    </div>

    <!-- Save / Cancel bar -->
    <div style="display:flex; align-items:center; justify-content:flex-end; gap:12px; padding:12px 16px; border-top:1px solid var(--color-border);">
        @if (!string.IsNullOrEmpty(_saveMessage))
        {
            <span class="@_saveMessageCss">@_saveMessage</span>
        }
        <button class="btn" @onclick="SaveSettings">Speichern</button>
        <button class="btn btn-secondary" @onclick="CancelSettings">Abbrechen</button>
    </div>
</div>

@code {
    private AppSettings _settings = new();
    private string ActiveTab { get; set; } = "virtuagym";
    private string SubTab { get; set; } = "welcome";
    private string DevSubTab { get; set; } = "gatetest";

    private string? _saveMessage;
    private string _saveMessageCss = "";

    protected override void OnInitialized()
    {
        _settings = SettingsOptions.Value;
    }

    private void SaveSettings()
    {
        try
        {
            SettingsService.Save(_settings);
            HardwareScannerService.Reload();
            BackgroundTaskService.Reload();
            _saveMessage = "Einstellungen gespeichert. Hardware-Scanner und Hintergrund-Dienste neu geladen.";
            _saveMessageCss = "text-success";
        }
        catch (Exception ex)
        {
            _saveMessage = $"Fehler beim Speichern: {ex.Message}";
            _saveMessageCss = "text-error";
        }
    }

    private void CancelSettings()
    {
        Navigation.NavigateTo("/");
    }

    [Inject] private NavigationManager Navigation { get; set; } = default!;
}
