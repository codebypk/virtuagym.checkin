<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AssemblyName>VirtuagymCheckIn</AssemblyName>
    <RootNamespace>Virtuagym.CheckIn.WPF</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>Main.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup>
    <StartupObject>Virtuagym.CheckIn.WPF.App</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Compatibility\**" />
    <EmbeddedResource Remove="Compatibility\**" />
    <None Remove="Compatibility\**" />
    <Page Remove="Compatibility\**" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Main.ico" />
    <Content Include="Main.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <Page Update="Controls\ApiConnectionControl.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Controls\CheckinMappingsControl.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Controls\ClubServicesControl.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Controls\DeveloperJablotronControl.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Controls\DeveloperJablotronGateTestControl.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Controls\DeveloperSimulationControl.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Controls\MemberToolsControl.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Controls\JablotronClientControl.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Controls\WelcomeScreenSettingsControl.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Controls\AccessPassControl.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="EditWindows\EditClubServiceWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="EditWindows\EditCacheEntryWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="EditWindows\EditCheckinClientMappingWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="EditWindows\EditMemberWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="EditWindows\WebcamCaptureWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="WelcomeWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Main.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Virtuagym.API\Virtuagym.API.csproj" />
    <ProjectReference Include="..\Virtuagym.CheckIn.Core\Virtuagym.CheckIn.Core.csproj" />
    <ProjectReference Include="..\Jablotron.API\Jablotron.API.csproj" />
    <ProjectReference Include="..\Hardware\Hardware.csproj" />
    <ProjectReference Include="..\AccessPass\AccessPass.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260302" />
    <PackageReference Include="OpenCvSharp4.Extensions" Version="4.13.0.20260318" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>
   <ItemGroup>
    <Content Include="..\Resources\**" Link="resources\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>