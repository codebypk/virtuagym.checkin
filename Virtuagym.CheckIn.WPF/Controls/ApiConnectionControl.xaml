<UserControl x:Class="Virtuagym.CheckIn.WPF.Controls.ApiConnectionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Virtuagym.CheckIn.WPF"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="White">
        <StackPanel Margin="10">
            <!-- Allgemein (v0 + v1) -->
            <GroupBox x:Name="grpApiGeneral" Header="Allgemein" Margin="0,0,0,10">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="lblApiKey" Grid.Row="0" Grid.Column="0" Text="API-Key:" VerticalAlignment="Center" Margin="0,5"/>
                    <TextBox x:Name="txtVirtuagymApiKey" Grid.Row="0" Grid.Column="1" Margin="0,5"
                             ToolTip="API-Key für Virtuagym v1 API."/>

                    <TextBlock x:Name="lblServerUrl" Grid.Row="1" Grid.Column="0" Text="Server-URL:" VerticalAlignment="Center" Margin="0,5"/>
                    <TextBox x:Name="txtVirtuagymServerUrl" Grid.Row="1" Grid.Column="1" Margin="0,5"
                             ToolTip="Basis-URL des Virtuagym-Servers (z.B. https://api.virtuagym.com)."/>

                    <TextBlock x:Name="lblClubSecret" Grid.Row="2" Grid.Column="0" Text="Club-Secret:" VerticalAlignment="Center" Margin="0,5"/>
                    <TextBox x:Name="txtVirtuagymClubSecret" Grid.Row="2" Grid.Column="1" Margin="0,5"
                             ToolTip="Club-Secret / Check-In Key (VirtuagymClubSecret)."/>
                </Grid>
            </GroupBox>

            <!-- v0 API (Check-in / Basic Auth) -->
            <GroupBox x:Name="grpV0Api" Header="v0 API (Check-in / Basic Auth)" Margin="0,0,0,10">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="lblCheckinApiKey" Grid.Row="0" Grid.Column="0" Text="Check-in API-Key:" VerticalAlignment="Center" Margin="0,5"/>
                    <TextBox x:Name="txtCheckinApiKey" Grid.Row="0" Grid.Column="1" Margin="0,5"
                             ToolTip="API-Key für v0-Endpunkte (z.B. Check-in über PUT /devices). Wird zusammen mit dem jeweiligen Check-In Key des Mappings verwendet."/>

                    <TextBlock x:Name="lblCheckinApiUsername" Grid.Row="1" Grid.Column="0" Text="Benutzername:" VerticalAlignment="Center" Margin="0,5"/>
                    <TextBox x:Name="txtCheckinApiUsername" Grid.Row="1" Grid.Column="1" Margin="0,5"
                             ToolTip="Benutzername für v0 Basic Auth."/>

                    <TextBlock x:Name="lblCheckinApiPassword" Grid.Row="2" Grid.Column="0" Text="Passwort:" VerticalAlignment="Center" Margin="0,5"/>
                    <PasswordBox x:Name="txtCheckinApiPassword" Grid.Row="2" Grid.Column="1" Margin="0,5"
                                 ToolTip="Passwort für v0 Basic Auth."/>
                </Grid>
            </GroupBox>

            <!-- Verbindungstest -->
            <GroupBox x:Name="grpConnectionTest" Header="Verbindungstest" Margin="0,0,0,10">
                <StackPanel Margin="10">
                    <Button x:Name="btnTestVirtuagymConnection"
                            Content="Verbindung testen" Width="150" Height="28" HorizontalAlignment="Left"
                            Click="btnTestVirtuagymConnection_Click"/>
                    <TextBlock x:Name="txtVirtuagymTestResult"
                               TextWrapping="Wrap" Foreground="Gray" FontSize="12" Margin="0,5,0,0"/>
                </StackPanel>
            </GroupBox>

            <!-- Member-Cache -->
            <GroupBox x:Name="grpMemberCache" Header="Member-Cache (Synchronisation)" Margin="0,0,0,10">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="txtCacheLocalDesc" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" 
                               Text="Lokaler Member-Cache f&#252;r schnellere Check-ins und weniger API-Requests:" 
                               FontWeight="SemiBold" Margin="0,0,0,5"/>

                    <CheckBox x:Name="chkMemberCacheEnabled" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" 
                              Content="Member-Cache aktivieren" Margin="0,5"
                              ToolTip="Wenn aktiviert, werden Mitglieder-Daten lokal zwischengespeichert f&#252;r schnellere Check-ins, Offline-Fallback und Duplikat-Schutz."
                              Checked="chkMemberCacheEnabled_Changed" Unchecked="chkMemberCacheEnabled_Changed"/>

                    <CheckBox x:Name="chkCacheSyncEnabled" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" 
                              Content="Automatische Synchronisation aktivieren" Margin="0,5"
                              ToolTip="Wenn aktiviert, werden Mitglieder-Daten periodisch von der API synchronisiert."
                              Checked="chkCacheSyncEnabled_Changed" Unchecked="chkCacheSyncEnabled_Changed"/>

                    <!-- Sync-Modus Auswahl -->
                    <TextBlock x:Name="lblSyncMode" Grid.Row="3" Grid.Column="0" Text="Sync-Modus:" VerticalAlignment="Center" Margin="0,5"/>
                    <ComboBox x:Name="cmbSyncMode" Grid.Row="3" Grid.Column="1" Margin="0,5" Width="200" HorizontalAlignment="Left"
                              SelectionChanged="cmbSyncMode_SelectionChanged">
                        <ComboBoxItem x:Name="cmbSyncModeInterval" Content="Intervall" Tag="Interval"/>
                        <ComboBoxItem x:Name="cmbSyncModeDailyTime" Content="T&#228;glich um Uhrzeit" Tag="DailyTime"/>
                    </ComboBox>

                    <!-- Intervall (nur sichtbar bei Modus "Interval") -->
                    <TextBlock x:Name="lblSyncInterval" Grid.Row="4" Grid.Column="0" Text="Intervall (Minuten):" VerticalAlignment="Center" Margin="0,5"/>
                    <TextBox x:Name="txtCacheSyncIntervalMinutes" Grid.Row="4" Grid.Column="1" Margin="0,5" Width="80" HorizontalAlignment="Left"
                             ToolTip="Synchronisationsintervall in Minuten (z.B. 60 = st&#252;ndlich)."/>

                    <!-- Uhrzeit (nur sichtbar bei Modus "DailyTime") -->
                    <TextBlock x:Name="lblSyncDailyTime" Grid.Row="5" Grid.Column="0" Text="Uhrzeit (HH:mm):" VerticalAlignment="Center" Margin="0,5"/>
                    <TextBox x:Name="txtCacheSyncDailyTime" Grid.Row="5" Grid.Column="1" Margin="0,5" Width="80" HorizontalAlignment="Left"
                             ToolTip="Uhrzeit im 24-Stunden-Format, z.B. 02:00 f&#252;r 2 Uhr nachts."/>

                    <!-- Credits-Cache TTL -->
                    <TextBlock x:Name="lblCreditsCacheTtl" Grid.Row="6" Grid.Column="0" Text="Credits-Cache TTL (Min):" VerticalAlignment="Center" Margin="0,5"/>
                    <TextBox x:Name="txtCreditsCacheTtlMinutes" Grid.Row="6" Grid.Column="1" Margin="0,5" Width="80" HorizontalAlignment="Left"
                             ToolTip="Wie lange gecachte Credits g&#252;ltig bleiben (in Minuten). Standard: 60. | bei 0 deaktiviert"/>

                    <TextBlock x:Name="txtCacheSyncStatus" Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" 
                               Foreground="Gray" FontSize="12" Margin="0,5" TextWrapping="Wrap"/>

                    <ProgressBar x:Name="pgbCacheSync" Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2"
                                 Height="18" Margin="0,5" Minimum="0" Maximum="100" Value="0"
                                 Visibility="Collapsed"/>

                    <TextBlock x:Name="txtCacheSyncProgress" Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2" 
                               Foreground="Gray" FontSize="11" Margin="0,2,0,5" TextWrapping="Wrap"
                               Visibility="Collapsed"/>

                    <StackPanel Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,5">
                        <Button x:Name="btnCacheSyncNow" Content="Jetzt synchronisieren" Width="160" Height="28" Margin="0,0,10,0"
                                Click="btnCacheSyncNow_Click"
                                ToolTip="Startet eine manuelle Synchronisation aller Mitglieder von der API."/>
                        <Button x:Name="btnCacheClear" Content="Cache leeren" Width="120" Height="28"
                                Click="btnCacheClear_Click"
                                ToolTip="L&#246;scht alle lokal gespeicherten Mitglieder-Daten."/>
                    </StackPanel>
                </Grid>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>