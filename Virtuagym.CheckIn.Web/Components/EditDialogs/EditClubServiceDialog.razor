@* Modal dialog for editing a club service *@
<div class="modal-overlay @(_visible ? "visible" : "")">
    <div class="modal-dialog">
        <div class="modal-header">
            <h4>Edit Club Service</h4>
            <button class="modal-close" @onclick="Close">&times;</button>
        </div>
        <div class="modal-body">
            <div class="form-group">
                <label>Club-ID:</label>
                <input type="number" @bind="ClubId" class="form-input" />
            </div>
            <div class="form-group">
                <label>Service-ID:</label>
                <input type="text" @bind="ServiceId" class="form-input" />
            </div>
            <div class="form-group">
                <label>Service Name:</label>
                <input type="text" @bind="ServiceName" class="form-input" />
            </div>
            <div class="form-group">
                <label>Min Credits:</label>
                <input type="number" @bind="MinCredits" class="form-input" />
            </div>
            <div class="form-group">
                <label>Active:</label>
                <input type="checkbox" @bind="IsActive" />
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn" @onclick="Save">Save</button>
            <button class="btn btn-secondary" @onclick="Close">Cancel</button>
        </div>
    </div>
</div>

@code {
    private bool _visible;

    [Parameter] public int ClubId { get; set; }
    [Parameter] public string ServiceId { get; set; } = "";
    [Parameter] public string ServiceName { get; set; } = "";
    [Parameter] public int MinCredits { get; set; }
    [Parameter] public bool IsActive { get; set; } = true;
    [Parameter] public EventCallback<bool> OnClose { get; set; }

    public void Show() { _visible = true; StateHasChanged(); }
    private async Task Close() { _visible = false; await OnClose.InvokeAsync(false); }
    private async Task Save() { _visible = false; await OnClose.InvokeAsync(true); }
}
