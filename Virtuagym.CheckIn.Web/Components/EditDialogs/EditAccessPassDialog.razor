@using AccessPass.Models
@using AccessPass.Services
@using Virtuagym.CheckIn.Core.Services
@using Virtuagym.CheckIn.Web.Services
@using Microsoft.AspNetCore.Components.Forms
@inject HardwareScannerService HardwareScanner
@inject AccessPassQrService QrService
@inject IJSRuntime JS
@implements IDisposable

<div class="modal-overlay visible">
    <div class="modal-dialog modal-lg">
        <div class="modal-header">
            <h4>@(IsNew ? L.T("AP_Edit_Title_New") : $"{L.T("AP_Edit_Title_Edit")}: {Entry.DisplayName}")</h4>
            <button class="modal-close" @onclick="Cancel">&times;</button>
        </div>
        <div class="modal-body">
            <div style="display:grid; grid-template-columns:160px 1fr; gap:8px 12px; align-items:center;">

                <label>@L.T("AP_Edit_Lbl_Name")</label>
                <input type="text" class="form-input" @bind="_name" placeholder="@L.T("AP_Edit_Placeholder_Name")" />

                <label>@L.T("AP_Edit_Lbl_Photo")</label>
                <div style="display:flex; gap:10px; align-items:center;">
                    <div style="width:80px; height:80px; border:1px solid #ccc; background:#f5f5f5; display:flex; align-items:center; justify-content:center; overflow:hidden;">
                        @if (!string.IsNullOrEmpty(_photoPreviewUrl))
                        {
                            <img src="@_photoPreviewUrl" style="width:100%; height:100%; object-fit:cover;" />
                        }
                        else
                        {
                            <span style="color:#aaa; font-size:11px;">@L.T("AP_Edit_Lbl_NoPhoto")</span>
                        }
                    </div>
                    <div style="display:flex; flex-direction:column; gap:4px;">
                        <InputFile OnChange="OnPhotoSelected" accept="image/*" style="font-size:12px; width:160px;" />
                        <button type="button" class="btn btn-secondary" style="padding:2px 10px; font-size:12px;" @onclick="OpenWebcamDialog">@L.T("AP_Edit_Btn_Webcam")</button>
                        @if (!string.IsNullOrEmpty(_photoPreviewUrl))
                        {
                            <button type="button" class="btn btn-secondary" style="padding:2px 10px; font-size:12px; background:#b71c1c;" @onclick="RemovePhoto">@L.T("AP_Edit_Btn_RemovePhoto")</button>
                        }
                    </div>
                </div>

                <label>@L.T("AP_Edit_Lbl_CardId")</label>
                <div style="display:flex; gap:6px; align-items:center;">
                    <input type="text" class="form-input" value="@_cardId" readonly style="flex:1; background:#f0f0f0;" />
                    @if (IsNew || string.IsNullOrWhiteSpace(Entry.CardId))
                    {
                        <button type="button" class="btn btn-secondary" style="white-space:nowrap;" @onclick="GenerateCardId">@L.T("AP_Edit_Btn_Generate")</button>
                        <button type="button" class="btn btn-secondary" style="white-space:nowrap;" @onclick="ToggleReadCard">@(_isReadingCard ? L.T("Btn_Cancel") : L.T("AP_Edit_Btn_ReadCard"))</button>
                    }
                </div>
                @if (_isReadingCard)
                {
                    <span></span>
                    <div style="color:darkorange; font-size:0.85em;">@L.T("AP_Edit_Hint_CardReading")</div>
                }

                <label>@L.T("AP_Edit_Lbl_Unlimited")</label>
                <input type="checkbox" @bind="_isUnlimited" />

                <label>@L.T("AP_Edit_Lbl_TotalUses")</label>
                <input type="number" class="form-input" style="width:100px;@(_isUnlimited ? " opacity:0.5;" : "")" min="1" @bind="_totalUses" disabled="@_isUnlimited" />

                <label>@L.T("AP_Edit_Lbl_RemainingUses")</label>
                <input type="number" class="form-input" style="width:100px;@(_isUnlimited ? " opacity:0.5;" : "")" min="0" @bind="_remainingUses" disabled="@_isUnlimited" />

                <label>@L.T("AP_Edit_Lbl_ValidFrom")</label>
                <input type="datetime-local" class="form-input" style="width:220px;@(_isUnlimited ? " opacity:0.5;" : "")" @bind="_validFrom" disabled="@_isUnlimited" />

                <label>@L.T("AP_Edit_Lbl_ValidUntil")</label>
                <input type="datetime-local" class="form-input" style="width:220px;@(_isUnlimited ? " opacity:0.5;" : "")" @bind="_validUntil" disabled="@_isUnlimited" />

                <label>@L.T("AP_Edit_Lbl_Active")</label>
                <input type="checkbox" @bind="_isActive" />
            </div>

            <!-- QR Code -->
            <div style="margin-top:12px;">
                <button type="button" class="btn btn-secondary" @onclick="GenerateQrCode">@L.T("AP_Edit_Btn_GenerateQr")</button>
                @if (!string.IsNullOrEmpty(_qrError))
                {
                    <span style="color:red; margin-left:10px; font-size:0.85em;">@_qrError</span>
                }
                @if (!string.IsNullOrEmpty(_qrDataUri))
                {
                    <div style="margin-top:8px;">
                        <img src="@_qrDataUri" alt="QR-Code" style="width:180px; height:180px;" />
                    </div>
                }
            </div>

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="test-result error" style="margin-top:12px;">@_error</div>
            }
        </div>
        <div class="modal-footer">
            <button class="btn btn-secondary" @onclick="Cancel">@L.T("Btn_Cancel")</button>
            <button class="btn" @onclick="Save">@L.T("AP_Edit_Btn_Save")</button>
        </div>
    </div>
</div>

@if (_showWebcamCapture)
{
    <div class="modal-overlay visible" style="z-index:1200;">
        <div class="modal-dialog" style="width:min(90vw,720px);">
            <div class="modal-header">
                <h4>@L.T("AP_Edit_Btn_Webcam")</h4>
                <button class="modal-close" @onclick="CloseWebcamDialog">&times;</button>
            </div>
            <div class="modal-body">
                <div style="display:flex; align-items:center; gap:10px; margin-bottom:10px;">
                    <label style="min-width:70px;">Kamera:</label>
                    <select class="form-input" style="flex:1;" value="@_selectedWebcamDeviceId" @onchange="OnWebcamDeviceChanged" disabled="@_webcamInitializing">
                        @foreach (var camera in _webcamDevices)
                        {
                            <option value="@camera.DeviceId">@camera.Label</option>
                        }
                    </select>
                </div>

                <div style="width:100%; background:#111; border-radius:8px; border:1px solid #444; overflow:hidden; min-height:300px; display:flex; align-items:center; justify-content:center;">
                    <video @ref="_webcamVideoElement" autoplay playsinline muted style="width:100%; height:auto; display:block;"></video>
                </div>

                @if (_webcamInitializing)
                {
                    <div class="text-muted" style="margin-top:8px;">Kamera wird gestartet...</div>
                }
                @if (!string.IsNullOrWhiteSpace(_webcamError))
                {
                    <div class="test-result error" style="margin-top:8px;">@_webcamError</div>
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseWebcamDialog">@L.T("Btn_Cancel")</button>
                <button class="btn" @onclick="CaptureWebcamPhoto" disabled="@_webcamInitializing">@L.T("AP_Edit_Webcam_Btn_Capture")</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public AccessPassEntry Entry { get; set; } = new();
    [Parameter] public bool IsNew { get; set; }
    [Parameter] public EventCallback<AccessPassEntry> OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public string ClubSecret { get; set; } = "";
    [Parameter] public string? ExistingAvatarUrl { get; set; }

    private string? _name;
    private string? _cardId;
    private int _totalUses;
    private int _remainingUses;
    private DateTime? _validFrom;
    private DateTime? _validUntil;
    private bool _isActive;
    private bool _isUnlimited;
    private string? _error;
    private bool _isReadingCard;
    private string? _qrDataUri;
    private string? _qrError;
    private string? _photoPreviewUrl;
    private byte[]? _photoBytes;
    private bool _photoRemoved;
    private bool _showWebcamCapture;
    private bool _webcamPreviewActive;
    private bool _webcamInitializing;
    private string? _webcamError;
    private string? _selectedWebcamDeviceId;
    private List<WebcamDeviceOption> _webcamDevices = [];
    private ElementReference _webcamVideoElement;

    /// <summary>Photo bytes selected/captured by the user, or null.</summary>
    public byte[]? PhotoBytes => _photoBytes;
    /// <summary>Whether the user explicitly removed the photo.</summary>
    public bool PhotoRemoved => _photoRemoved;

    protected override void OnParametersSet()
    {
        _name = Entry.Name;
        _cardId = Entry.CardId;
        _totalUses = Entry.TotalUses;
        _remainingUses = Entry.RemainingUses;
        _isActive = Entry.IsActive;
        _isUnlimited = Entry.IsUnlimited;

        _validFrom = TryParseIso(Entry.ValidFrom);
        _validUntil = TryParseIso(Entry.ValidUntil);

        _photoPreviewUrl = ExistingAvatarUrl;
        _photoBytes = null;
        _photoRemoved = false;
    }

    private void GenerateCardId()
    {
        _cardId = Guid.NewGuid().ToString("N");
    }

    private void ToggleReadCard()
    {
        if (_isReadingCard)
        {
            StopReadCard();
        }
        else
        {
            _isReadingCard = true;
            HardwareScanner.OnCardScanned += OnCardScanned;
        }
    }

    private void OnCardScanned(string cardId)
    {
        InvokeAsync(() =>
        {
            _cardId = cardId;
            StopReadCard();
            StateHasChanged();
        });
    }

    private void StopReadCard()
    {
        _isReadingCard = false;
        HardwareScanner.OnCardScanned -= OnCardScanned;
    }

    public void Dispose()
    {
        HardwareScanner.OnCardScanned -= OnCardScanned;
        _ = StopWebcamPreviewAsync();
        _dotNetRef?.Dispose();
    }

    /// <summary>
    /// Kann von außen aufgerufen werden, um eine gelesene Card-ID zu setzen.
    /// </summary>
    public void SetCardId(string cardId)
    {
        _cardId = cardId;
        _isReadingCard = false;
        StateHasChanged();
    }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(_name))
        {
            _error = L.T("AP_Edit_Err_NameRequired");
            return;
        }
        if (string.IsNullOrWhiteSpace(_cardId))
        {
            _error = L.T("AP_Edit_Err_CardIdRequired");
            return;
        }
        if (!_isUnlimited && _totalUses < 1)
        {
            _error = L.T("AP_Edit_Err_TotalUsesMin");
            return;
        }

        Entry.Name = _name?.Trim();
        Entry.CardId = _cardId?.Trim();
        Entry.IsUnlimited = _isUnlimited;
        Entry.TotalUses = _isUnlimited ? 0 : _totalUses;
        Entry.RemainingUses = _isUnlimited ? 0 : _remainingUses;
        Entry.IsActive = _isActive;
        Entry.ValidFrom = !_isUnlimited && _validFrom.HasValue ? _validFrom.Value.ToUniversalTime().ToString("o") : null;
        Entry.ValidUntil = !_isUnlimited && _validUntil.HasValue ? _validUntil.Value.ToUniversalTime().ToString("o") : null;

        await OnSave.InvokeAsync(Entry);
    }

    private void GenerateQrCode()
    {
        _qrError = null;
        _qrDataUri = null;

        if (string.IsNullOrWhiteSpace(_cardId))
        {
            _qrError = L.T("AP_Edit_Err_QrNoCardId");
            return;
        }
        if (string.IsNullOrWhiteSpace(ClubSecret))
        {
            _qrError = L.T("AP_Edit_Err_QrNoSecret");
            return;
        }

        var tempEntry = new AccessPassEntry { 
            Id = Entry.Id, 
            CardId = _cardId!.Trim(), 
            IsUnlimited = _isUnlimited, 
            ValidFrom = !_isUnlimited && _validFrom.HasValue ? _validFrom.Value.ToUniversalTime().ToString("o") : null,
            ValidUntil = !_isUnlimited && _validUntil.HasValue ? _validUntil.Value.ToUniversalTime().ToString("o") : null 
        };
        var (_, dataUri) = QrService.GenerateTokenAndQr(tempEntry, ClubSecret);
        if (string.IsNullOrEmpty(dataUri))
        {
            _qrError = L.T("AP_Edit_Err_QrFailed");
            return;
        }
        _qrDataUri = dataUri;
    }

    private async Task Cancel()
    {
        await CloseWebcamDialog();
        await OnCancel.InvokeAsync();
    }

    private async Task OnPhotoSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;
        using var ms = new System.IO.MemoryStream();
        await file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024).CopyToAsync(ms);
        _photoBytes = ms.ToArray();
        _photoRemoved = false;
        _photoPreviewUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(_photoBytes)}";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_showWebcamCapture && !_webcamPreviewActive && !_webcamInitializing)
            await InitializeWebcamPreviewAsync();
    }

    private async Task OpenWebcamDialog()
    {
        _error = null;
        _webcamError = null;
        _showWebcamCapture = true;
        _webcamPreviewActive = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task InitializeWebcamPreviewAsync()
    {
        _webcamInitializing = true;
        try
        {
            HardwareScanner.PauseAllCameras();

            var devices = await JS.InvokeAsync<List<WebcamDeviceOption>>("webcamGetDevices") ?? [];
            _webcamDevices = devices;

            if (_webcamDevices.Count == 0)
            {
                _webcamError = L.T("AP_Edit_Err_WebcamFailed");
                return;
            }

            _selectedWebcamDeviceId ??= _webcamDevices[0].DeviceId;
            await JS.InvokeVoidAsync("webcamStartPreview", _webcamVideoElement, _selectedWebcamDeviceId);
            _webcamPreviewActive = true;
            _webcamError = null;
        }
        catch(Exception ex) when (ex is JSException or TaskCanceledException or OperationCanceledException)
        {
            _webcamError = L.T("AP_Edit_Err_WebcamFailed");
        }
        finally
        {
            _webcamInitializing = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OnWebcamDeviceChanged(ChangeEventArgs e)
    {
        _selectedWebcamDeviceId = e.Value?.ToString();
        try
        {
            await JS.InvokeVoidAsync("webcamStartPreview", _webcamVideoElement, _selectedWebcamDeviceId);
            _webcamPreviewActive = true;
            _webcamError = null;
        }
        catch (Exception ex) when (ex is JSException or TaskCanceledException or OperationCanceledException)
        {
            _webcamError = L.T("AP_Edit_Err_WebcamFailed");
        }
    }

    private DotNetObjectReference<EditAccessPassDialog>? _dotNetRef;

    private async Task CaptureWebcamPhoto()
    {
        try
        {
            _dotNetRef ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("webcamCaptureFrameCallback", _dotNetRef);
        }
        catch
        {
            _webcamError = L.T("AP_Edit_Err_WebcamFailed");
        }
    }

    [JSInvokable]
    public async Task OnWebcamCaptureResult(string? base64)
    {
        if (string.IsNullOrWhiteSpace(base64))
        {
            _webcamError = L.T("AP_Edit_Err_WebcamFailed");
        }
        else
        {
            _photoBytes = Convert.FromBase64String(base64);
            _photoRemoved = false;
            _photoPreviewUrl = $"data:image/jpeg;base64,{base64}";
            await CloseWebcamDialog();
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task CloseWebcamDialog()
    {
        await StopWebcamPreviewAsync();
        _showWebcamCapture = false;
        _webcamInitializing = false;
        _webcamError = null;
        await InvokeAsync(StateHasChanged);
    }

    private async Task StopWebcamPreviewAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("webcamStopPreview", _webcamVideoElement);
        }
        catch
        {
            // ignored on teardown/disconnect
        }
        _webcamPreviewActive = false;

        try
        {
            HardwareScanner.ResumeAllCameras();
        }
        catch
        {
            // best effort on teardown
        }
    }

    private void RemovePhoto()
    {
        _photoBytes = null;
        _photoRemoved = true;
        _photoPreviewUrl = null;
    }

    private static DateTime? TryParseIso(string? iso)
    {
        if (string.IsNullOrWhiteSpace(iso)) return null;
        return DateTime.TryParse(iso, null, System.Globalization.DateTimeStyles.RoundtripKind, out var dt)
            ? dt.ToLocalTime()
            : null;
    }

    private sealed class WebcamDeviceOption
    {
        public string DeviceId { get; set; } = "";
        public string Label { get; set; } = "";
    }
}
