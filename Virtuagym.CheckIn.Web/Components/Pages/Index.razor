@page "/"
@using Virtuagym.CheckIn.Web.Services
@using Virtuagym.CheckIn.Core.Helper
@inject WebLogService LogService
@implements IDisposable

<h3>Log</h3>

<div class="log-container">
    @foreach (var entry in _logEntries)
    {
        <div class="log-entry log-@entry.CssClass">
            @entry.Text
        </div>
    }
</div>

@code {
    private List<LogEntry> _logEntries = new();
    private bool _disposed;
    private bool _pendingUpdate;

    protected override void OnInitialized()
    {
        LogService.OnLogEntry += HandleLogEntry;
        _logEntries = LogService.GetRecentEntries().ToList();
    }

    private async void HandleLogEntry(LogEntry entry)
    {
        if (_disposed) return;

        // Batch: buffer the entry and coalesce UI updates
        lock (_logEntries)
        {
            _logEntries.Add(entry);
            while (_logEntries.Count > Constants.MaxLogEntries)
                _logEntries.RemoveAt(0);

            if (_pendingUpdate)
                return;
            _pendingUpdate = true;
        }

        // Debounce: wait briefly to batch rapid log bursts
        await Task.Delay(100);
        if (_disposed) return;

        try
        {
            await InvokeAsync(() =>
            {
                _pendingUpdate = false;
                StateHasChanged();
            });
        }
        catch { _pendingUpdate = false; }
    }

    public void Dispose()
    {
        _disposed = true;
        LogService.OnLogEntry -= HandleLogEntry;
    }
}
