    private async Task Save()
    {
        _validationError = "";

        // Validation (matching WPF)
        if (Mapping.InputType == CheckinClientMapping.InputTypeRfid && string.IsNullOrWhiteSpace(Mapping.DeviceID) && string.IsNullOrWhiteSpace(_selectedDeviceId))
        {
            _validationError = L.T("Web_EditMapping_Validation_SelectDevice");
            return;
        }
        if (Mapping.InputType == CheckinClientMapping.InputTypeQrCode && _cameras.Count == 0)
        {
            _validationError = L.T("Web_EditMapping_Validation_NoCamera");
            return;
        }
        if (string.IsNullOrWhiteSpace(Mapping.CheckinKey))
        {
            _validationError = L.T("Web_EditMapping_Validation_EnterKey");
            return;
        }

        // Apply selected device ID from dropdown if set
        if (!string.IsNullOrWhiteSpace(_selectedDeviceId))
            Mapping.DeviceID = _selectedDeviceId;

        // Apply camera resolution
        var resParts = _cameraResolution.Split('x');
        if (resParts.Length == 2 && int.TryParse(resParts[0], out int w) && int.TryParse(resParts[1], out int h))
        {
            Mapping.CameraResolutionWidth = w;
            Mapping.CameraResolutionHeight = h;
        }

        // Apply HID profile
        Mapping.HidProfile = _selectedHidProfileId;

        // Apply repeat time and duplicate timeout
        Mapping.RepeatTimeMs = _repeatTimeMs;
        Mapping.DuplicateTimeoutSeconds = _duplicateTimeoutSeconds;

        // Apply PG gate data
        var selectedGate = _pgGates.FirstOrDefault(g => g.CloudComponentId == _selectedPgGateComponentId);
        Mapping.PgGateComponentId = selectedGate?.CloudComponentId ?? "";
        Mapping.PgGateServiceId = selectedGate?.ServiceId ?? "";
        Mapping.PgGateName = selectedGate?.Name ?? "";

        var condGate = _pgGates.FirstOrDefault(g => g.CloudComponentId == _selectedPgCondGateComponentId);
        Mapping.PgConditionGateComponentId = condGate?.CloudComponentId ?? "";
        Mapping.PgConditionGateServiceId = condGate?.ServiceId ?? "";
        Mapping.PgConditionGateName = condGate?.Name ?? "";

        // Apply credit club ID from selected service
        var creditSvc = _creditServices.FirstOrDefault(s => s.service_id == Mapping.CreditServiceId);
        Mapping.CreditClubId = creditSvc?.club_id ?? 0;

        await OnSave.InvokeAsync(Mapping);
    }

    private async Task Cancel()
    {
        StopCameraPreview();
        StopQrScanTest();
        await OnCancel.InvokeAsync();
    }

    private async Task ToggleCameraPreview()
    {
        if (_cameraPreviewRunning)
        {
            StopCameraPreview();
            return;
        }

        _cameraPreviewRunning = true;
        _cameraPreviewStatus = L.T("Web_EditMapping_StartingCamera");
        _cameraPreviewBase64 = "";
        StateHasChanged();

        _previewCts = new CancellationTokenSource();
        var ct = _previewCts.Token;

        _ = Task.Run(async () =>
        {
            VideoCapture capture = null;
            try
            {
                if (!Enum.TryParse<VideoCaptureAPIs>(Mapping.CameraBackend ?? "ANY", out var api))
                    api = VideoCaptureAPIs.ANY;

                capture = new VideoCapture(Mapping.CameraIndex, api);
                if (!capture.IsOpened())
                {
                    await InvokeAsync(() => { _cameraPreviewStatus = L.T("Web_EditMapping_CameraOpenFailed"); _cameraPreviewRunning = false; StateHasChanged(); });
                    return;
                }

                var resParts = _cameraResolution.Split('x');
                if (resParts.Length == 2 && int.TryParse(resParts[0], out int w) && int.TryParse(resParts[1], out int h))
                {
                    capture.Set(VideoCaptureProperties.FrameWidth, w);
                    capture.Set(VideoCaptureProperties.FrameHeight, h);
                }

                using var frame = new Mat();
                await InvokeAsync(() => { _cameraPreviewStatus = L.T("Web_EditMapping_PreviewActive"); StateHasChanged(); });

                while (!ct.IsCancellationRequested)
                {
                    if (capture.Read(frame) && !frame.Empty())
                    {
                        Cv2.ImEncode(".jpg", frame, out var jpegBytes);
                        var base64 = Convert.ToBase64String(jpegBytes);
                        await InvokeAsync(() => { _cameraPreviewBase64 = base64; StateHasChanged(); });
                    }
                    await Task.Delay(150, ct);
                }
            }
            catch (OperationCanceledException) { }
            catch (Exception ex)
            {
                await InvokeAsync(() => { _cameraPreviewStatus = string.Format(L.T("Web_EditMember_Error"), ex.Message); StateHasChanged(); });
            }
            finally
            {
                capture?.Release();
                capture?.Dispose();
                await InvokeAsync(() => { _cameraPreviewRunning = false; StateHasChanged(); });
            }
        }, ct);
    }

    private void StopCameraPreview()
    {
        _previewCts?.Cancel();
        _previewCts?.Dispose();
        _previewCts = null;
        _cameraPreviewRunning = false;
        _cameraPreviewBase64 = "";
        _cameraPreviewStatus = "";
    }

    // ── QR Scan Test (Device Test tab) ──

    private async Task StartQrScanTest()
    {
        if (_qrTestRunning) return;

        _qrTestRunning = true;
        _qrTestStatus = L.T("Web_EditMapping_StartingCamera");
        _qrTestPreviewBase64 = "";
        StateHasChanged();

        _qrTestCts = new CancellationTokenSource();
        var ct = _qrTestCts.Token;

        _ = Task.Run(async () =>
        {
            VideoCapture capture = null;
            try
            {
                if (!Enum.TryParse<VideoCaptureAPIs>(Mapping.CameraBackend ?? "ANY", out var api))
                    api = VideoCaptureAPIs.ANY;

                capture = new VideoCapture(Mapping.CameraIndex, api);
                if (!capture.IsOpened())
                {
                    await InvokeAsync(() => { _qrTestStatus = L.T("Web_EditMapping_CameraOpenFailed"); _qrTestRunning = false; StateHasChanged(); });
                    return;
                }

                var resParts = _cameraResolution.Split('x');
                if (resParts.Length == 2 && int.TryParse(resParts[0], out int w) && int.TryParse(resParts[1], out int h))
                {
                    capture.Set(VideoCaptureProperties.FrameWidth, w);
                    capture.Set(VideoCaptureProperties.FrameHeight, h);
                }

                using var frame = new Mat();
                using var reader = new QRCodeDetector();
                await InvokeAsync(() => { _qrTestStatus = L.T("Web_EditMapping_SearchingQr"); StateHasChanged(); });

                while (!ct.IsCancellationRequested)
                {
                    if (capture.Read(frame) && !frame.Empty())
                    {
                        // Try to detect QR code
                        var decoded = reader.DetectAndDecode(frame, out var points);
                        if (!string.IsNullOrEmpty(decoded))
                        {
                            await InvokeAsync(() =>
                            {
                                _qrTestStatus = string.Format(L.T("Web_EditMapping_QrDetected"), decoded);
                                _testCardId = decoded;
                                StateHasChanged();
                            });
                        }

                        Cv2.ImEncode(".jpg", frame, out var jpegBytes);
                        var base64 = Convert.ToBase64String(jpegBytes);
                        await InvokeAsync(() => { _qrTestPreviewBase64 = base64; StateHasChanged(); });
                    }
                    await Task.Delay(150, ct);
                }
            }
            catch (OperationCanceledException) { }
            catch (Exception ex)
            {
                await InvokeAsync(() => { _qrTestStatus = string.Format(L.T("Web_EditMember_Error"), ex.Message); StateHasChanged(); });
            }
            finally
            {
                capture?.Release();
                capture?.Dispose();
                await InvokeAsync(() => { _qrTestRunning = false; StateHasChanged(); });
            }
        }, ct);
    }

    private void StopQrScanTest()
    {
        _qrTestCts?.Cancel();
        _qrTestCts?.Dispose();
        _qrTestCts = null;
        _qrTestRunning = false;
        _qrTestPreviewBase64 = "";
        _qrTestStatus = L.T("Web_EditMapping_ScanCancelled");
    }

    public void Dispose()
    {
        StopCameraPreview();
        StopQrScanTest();
    }
