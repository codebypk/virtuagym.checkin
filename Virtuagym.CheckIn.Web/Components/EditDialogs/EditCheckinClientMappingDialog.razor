    private void ReloadPgGates()
    {
        try
        {
            PgGateLoader.ClearCache();
            _pgGates = PgGateLoader.Load();
            _pgStatus = _pgGates.Count > 0 ? string.Format(L.T("Web_EditMapping_GatesLoaded"), _pgGates.Count) : L.T("Web_EditMapping_NoGatesFound");
        }
        catch (Exception ex)
        {
            _pgGates = new();
            _pgStatus = string.Format(L.T("Web_EditMember_Error"), ex.Message);
        }
    }

    private async Task TestPgGate()
    {
        var gate = _pgGates.FirstOrDefault(g => g.CloudComponentId == _selectedPgGateComponentId);
        if (gate == null) { _pgStatus = L.T("Common_SelectGate"); return; }
        if (!gate.CanControl) { _pgStatus = L.T("Web_EditMapping_GateNotControllable"); return; }

        _pgStatus = string.Format(L.T("Web_EditMapping_GateSwitchingOn"), gate.Name);
        StateHasChanged();

        try
        {
            using var client = new Jablotron.API.Services.JablotronCloudService(
                SettingsOptions.Value.JablotronApiUrl, SettingsOptions.Value.JablotronApiUsername, SettingsOptions.Value.JablotronApiPassword);
            client.PerformLogin();

            int? serviceId = int.TryParse(gate.ServiceId, out var sid) && sid > 0 ? sid : null;
            var ok = client.ControlProgrammableGate(serviceId, gate.CloudComponentId, "ON");
            if (!ok) { _pgStatus = L.T("Web_EditMapping_GateOnFailed"); return; }

            _pgStatus = string.Format(L.T("Web_EditMapping_GateOnWaiting"), gate.Name, Mapping.PgTriggerTimeSec);
            StateHasChanged();

            if (Mapping.PgTriggerTimeSec > 0)
            {
                await Task.Delay(TimeSpan.FromSeconds(Mapping.PgTriggerTimeSec));
                var offOk = client.ControlProgrammableGate(serviceId, gate.CloudComponentId, "OFF");
                _pgStatus = offOk
                    ? string.Format(L.T("Web_EditMapping_GateTested"), gate.Name, Mapping.PgTriggerTimeSec)
                    : L.T("Web_EditMapping_GateOnButOffFailed");
            }
            else
            {
                _pgStatus = string.Format(L.T("Web_EditMapping_GateSetOn"), gate.Name);
            }
        }
        catch (Exception ex)
        {
            _pgStatus = string.Format(L.T("Web_EditMember_Error"), ex.Message);
        }
    }

