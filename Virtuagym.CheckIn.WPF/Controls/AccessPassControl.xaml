<UserControl x:Class="Virtuagym.CheckIn.WPF.Controls.AccessPassControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900" Background="White">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Info-Text -->
        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10"
                   x:Name="txtDescription"
                   Text="Temporäre Zugangspässe anlegen, bearbeiten und verwalten."/>

        <!-- DataGrid -->
        <DataGrid x:Name="dataGridAccessPasses" Grid.Row="1" AutoGenerateColumns="False" 
                  SelectionMode="Single" CanUserAddRows="False" IsReadOnly="True"
                  Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="*"/>
                <DataGridTextColumn Header="Card-ID" Binding="{Binding CardId}" Width="120"/>
                <DataGridTextColumn Header="Verbleibend" Binding="{Binding RemainingUses}" Width="90"/>
                <DataGridTextColumn Header="Gesamt" Binding="{Binding TotalUses}" Width="70"/>
                <DataGridTextColumn Header="Gültig bis" Binding="{Binding ValidUntil}" Width="140"/>
                <DataGridCheckBoxColumn Header="Aktiv" Binding="{Binding IsActive}" Width="50"/>
                <DataGridCheckBoxColumn Header="Eingecheckt" Binding="{Binding IsCheckedIn}" Width="85"/>
                <DataGridTextColumn Header="Erstellt" Binding="{Binding CreatedAt}" Width="140"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <Button x:Name="btnAddPass" Content="Neuen Pass erstellen" Width="160" Height="28" Margin="0,0,10,0"
                    Click="btnAddPass_Click"/>
            <Button x:Name="btnEditPass" Content="Bearbeiten" Width="100" Height="28" Margin="0,0,10,0"
                    Click="btnEditPass_Click"/>
            <Button x:Name="btnShowQr" Content="QR-Code" Width="100" Height="28" Margin="0,0,10,0"
                    Click="btnShowQr_Click"/>
            <Button x:Name="btnDeactivatePass" Content="Deaktivieren" Width="100" Height="28" Margin="0,0,10,0"
                    Click="btnDeactivatePass_Click"/>
            <Button x:Name="btnDeletePass" Content="Löschen" Width="100" Height="28" Margin="0,0,10,0"
                    Click="btnDeletePass_Click"/>
            <TextBlock x:Name="txtStatus" VerticalAlignment="Center" Margin="10,0,0,0" 
                       Foreground="Gray" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</UserControl>
